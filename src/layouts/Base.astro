---
import '../styles/global.css';
import '../styles/bright.css';
import fonts from '../data/font-manifest.json';
import fontsBright from '../data/font-manifest-bright.json';

/** set at build time — see BRIGHT in astro.config.mjs */
const bright = process.env.THEME === 'bright';
/** this museum's faces: names, hashed URLs, and its own stylesheet */
const face: Record<string, string> = bright ? fontsBright : fonts;
import PageNav from '../components/PageNav.astro';
import { useT, HTML_LANG, LANG_LABEL, type Lang } from '../i18n/ui';
import { home, browse, about, learn, asset, otherLang } from '../i18n/routing';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** path segments of the current page, so the language switch lands on its twin */
  segments?: (string | number)[];
  bare?: boolean;              // the great hall supplies its own header
}
const { lang, title, description, segments = [], bare = false } = Astro.props;
const t = useT(lang);
const other = otherLang(lang, ...segments);
const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
const desc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-theme={bright ? 'bright' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#120c06" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" hreflang="zh-Hant" href={new URL(otherLang('en', ...segments).href, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(otherLang('zh', ...segments).href, Astro.site)} />

    <link rel="preconnect" href="https://i.ytimg.com" />
    {/* The three faces are self-hosted, subset to the glyphs this site renders
        — see scripts/subset-fonts.mjs. Google Fonts sent 2.1–3.6 MB of CJK
        chunks per page and put a third party in the request path of every
        visit, which the About page's privacy claim is better without.
        Body text is preloaded; the other two are wanted a moment later. */}
    {/* One museum, one set of faces. Both name families like 'Noto Serif TC',
        so the stylesheets are linked rather than bundled — bundling both let
        the browser match the other museum's declaration and fetch a file that
        is not there. */}
    <link rel="stylesheet" href={face._stylesheet} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={bright ? face['source-sans-3'] : face['noto-sans-tc']} />
    {bright && (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={face['noto-sans-tc']} />
    )}

    <!-- decide motion before first paint, so nothing flashes on either setting -->
    <script is:inline>
      (function () {
        var p = 'auto';
        try { p = localStorage.getItem('nlm:motion') || 'auto'; } catch (e) {}
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.setAttribute(
          'data-motion', p === 'auto' ? (reduce ? 'off' : 'on') : p
        );
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>

    {bare && (
      <header class="topbar topbar--ghost">
        <div class="wrap topbar__in topbar__in--end">
          <nav class="topbar__nav" aria-label={t('nav.hall')}>
            <a href={browse(lang)}>{t('nav.all')}</a>
            <a href={learn(lang)}>{t('nav.learn')}</a>
            <a href={about(lang)}>{t('nav.about')}</a>
            <a class="topbar__lang" href={other.href} lang={other.lang === 'zh' ? 'zh-Hant-TW' : 'en'}>
              {LANG_LABEL[other.lang]}
            </a>
          </nav>
        </div>
      </header>
    )}

    {!bare && (
      <header class="topbar">
        <div class="wrap topbar__in">
          <a class="topbar__brand" href={home(lang)}>
            <img src={asset('ntu-logo.png')} alt="" width="34" height="34" />
            <span class="topbar__brand-txt">
              <span class="topbar__uni">{t('site.university')}</span>
              <span class="topbar__series">{t('site.tagline')}</span>
            </span>
          </a>
          <nav class="topbar__nav" aria-label={t('nav.hall')}>
            <a href={home(lang)}>{t('nav.hall')}</a>
            <a href={browse(lang)}>{t('nav.all')}</a>
            <a href={learn(lang)}>{t('nav.learn')}</a>
            <a href={about(lang)}>{t('nav.about')}</a>
            <a class="topbar__lang" href={other.href} lang={other.lang === 'zh' ? 'zh-Hant-TW' : 'en'}>
              {LANG_LABEL[other.lang]}
            </a>
          </nav>
        </div>
      </header>
    )}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__in">
        <img class="foot__crest" src={asset('ntu-logo.png')} alt="" width="56" height="56" />
        <div class="foot__lines">
          <p class="foot__copy foot__copy--zh" lang="zh-Hant-TW"><span class="foot__uni">國立臺灣大學</span>&nbsp;&nbsp;版權所有，禁止擅自轉貼節錄。本站為教育用途之獨立專案，與諾貝爾基金會無隸屬關係。</p>
          <p class="foot__copy">Copyright &copy; 2026 National Taiwan University - All rights reserved.</p>
        </div>
      </div>
    </footer>

    <PageNav lang={lang} />

    <style>
      .topbar {
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg-0) 88%, transparent);
        backdrop-filter: blur(10px);
        border-block-end: 1px solid var(--line);
      }
      /* over the hall: no panel, no brand — just a readability scrim so the
         controls stay legible against both the dark vault and the content
         further down the page */
      /* out of flow, so the hall fills the viewport behind it rather than
         starting below a 54px band of bare body background */
      .topbar--ghost {
        position: fixed;
        inset-inline: 0;
        inset-block-start: 0;
        background: none;
        backdrop-filter: none;
        border-block-end: 0;
      }
      /* the scrim is a pseudo-element so it can fade well past the bar's own
         height — a gradient squeezed into 3.4rem leaves a visible hard edge */
      .topbar--ghost::before {
        content: '';
        position: absolute;
        inset-inline: 0;
        inset-block-start: 0;
        block-size: 9rem;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(15, 10, 5, 0.66), rgba(15, 10, 5, 0.12) 55%, transparent);
      }
      .topbar--ghost .topbar__nav { position: relative; z-index: 1; }
      .topbar--ghost .topbar__in { justify-content: flex-end; min-block-size: 3.4rem; }

      .topbar__in {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-block-size: 4rem;
        flex-wrap: wrap;
      }
      .topbar__brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        text-decoration: none;
        color: var(--cream);
      }
      .topbar__brand img { border-radius: 50%; }
      .topbar__brand-txt { display: grid; line-height: 1.25; }
      .topbar__uni { font-size: var(--step--1); color: var(--muted); letter-spacing: 0.1em; }
      .topbar__series { font-family: var(--font-han-serif); font-size: var(--step-0); color: var(--cream); }

      .topbar__nav {
        display: flex; align-items: center; flex-wrap: wrap;
        row-gap: 0.15rem; column-gap: clamp(0.9rem, 2.5vw, 1.9rem);
        justify-content: flex-end;
      }
      .topbar__nav a {
        /* a nav label is one word: let the bar wrap between items, never inside one */
        white-space: nowrap;
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        color: var(--muted);
        text-decoration: none;
        padding-block: 0.4rem;
        border-block-end: 1px solid transparent;
        transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
      }
      .topbar__nav a:hover { color: var(--gold-bright); border-block-end-color: var(--gold); }
      .topbar__lang {
        border: 1px solid var(--line) !important;
        border-radius: 999px;
        padding: 0.22rem 0.85rem !important;
        color: var(--gold) !important;
      }
      .topbar__lang:hover { background: var(--surface-hi); }

      .foot {
        margin-block-start: clamp(4rem, 10vw, 8rem);
        border-block-start: 1px solid var(--line);
        background: var(--bg-1);
        padding-block: 2.5rem 3rem;
      }
      .foot__in {
        display: flex;
        align-items: center;
        gap: clamp(0.7rem, 2vw, 1.4rem);
      }
      .foot__crest {
        flex: none;
        inline-size: clamp(34px, 4.4vw, 56px);
        block-size: auto;
        opacity: 0.92;
      }
      .foot__lines { display: grid; gap: 0.2rem; min-inline-size: 0; }
      /* the copyright must stay on one line at every width, so it scales with
         the viewport rather than wrapping */
      .foot__copy {
        margin: 0;
        max-width: none;            /* global `p` caps at 62ch, which forced a wrap */
        color: var(--muted-dim);
        line-height: 1.8;
        white-space: nowrap;
        font-size: clamp(0.34rem, 1.38vw, 0.82rem);
      }
      .foot__copy--zh { letter-spacing: 0.01em; }
      /* the university's own name reads first */
      .foot__uni {
        color: var(--cream);
        font-size: 1.22em;
        letter-spacing: 0.04em;
      }
      /* tiny screens need the extra gutter back to keep it on one line */
      /* the crest takes width the line needs, so both shrink together here */
      @media (max-width: 26rem) {
        .foot .wrap { width: min(100% - 0.75rem, 76rem); }
        .foot__in { gap: 0.5rem; }
        .foot__crest { inline-size: 26px; }
      }
    </style>
  </body>
</html>
