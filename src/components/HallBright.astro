---
/**
 * HallBright.astro — the bright museum's entrance.
 *
 * A domed neoclassical rotunda — white marble, a glazed dome, a ring of arched
 * windows, two red banners — with a curved video wall standing in the apse and
 * six gold pieces set out on the floor in front of it.
 *
 * The hall is a photograph, so the wall's placement is measured, not guessed.
 * It has to be: the wall is positioned in per cent of a plate that carries the
 * picture's own aspect ratio, so picture and wall crop together and the wall
 * never drifts off the architecture.
 *
 * Finding the eye level takes a method a Hough transform cannot give. In a
 * rotunda most of what such a fit finds are dome ribs, and those converge on
 * the dome's own axis rather than the room's horizon. But a rotunda gives up
 * its horizon another way: its 'horizontal' lines are circles, and a circle
 * photographs as a straight line only when the camera's eye is at its height.
 * Fit the rings and read off where their curvature changes sign. Six agree
 * here — balustrade, entablature, window sill and column base all dip in the
 * middle, the step foot and a floor ring both rise — and the turn falls at
 * 69.2% of the plate, on the foot of the colonnade and level with the door's
 * threshold. See scripts/crop-hall.py.
 *
 * So the wall stands on that top step, its base exactly on the horizon, rising
 * to just under the doorway's arch — which is where a wall of screens would
 * stand in this room, and leaves the colonnade and the dome above it intact.
 *
 * No drifting embers, and no dust either. Embers belonged to a dark vault and
 * read as dirt on marble; motes are invisible against a hall this bright. The
 * light in this room is the photograph's own.
 */
import { useT, type Lang } from '../i18n/ui';
import { gallery, asset } from '../i18n/routing';
import { lectures, catName, catNameAlt, categoryList, introParts, INTRO } from '../data/catalog';
import credits from '../../data/model-credits.json';
import clips from '../data/backdrop.json';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const counts = lectures.reduce<Record<string, number>>((a, l) => {
  a[l.prize.category] = (a[l.prize.category] ?? 0) + 1;
  return a;
}, {});
const [introA, introConj, introB] = introParts(lang);

type Credit = { title: string; author: string; licence: string; page: string; source?: string };
const credited = credits as Record<string, Credit>;

/**
 * Anything under public/ keeps its URL forever, so a redeployed model sits
 * behind whatever the visitor already cached — GitHub Pages serves these with
 * max-age=600, and a swapped piece simply does not appear. Astro fingerprints
 * what it bundles; these it does not, so they are fingerprinted here, the same
 * way the objects hall does it.
 */
const stamp = (rel: string) => {
  const hash = createHash('sha256')
    .update(readFileSync(new URL(`../../public/${rel}`, import.meta.url)))
    .digest('hex').slice(0, 8);
  return `${asset(rel)}?v=${hash}`;
};

const cats = categoryList()
  .map((c) => c.key)
  .filter((k) => k in credited)
  .map((key) => ({
    key,
    name: catName(key, lang),
    nameAlt: catNameAlt(key, lang),
    n: counts[key] ?? 0,
    href: gallery(lang, key),
    model: stamp(`assets/models/gold/${key}.glb`),
    /* the gold poster, not the other museum's. This hall showed the dark
       museum's palette until its GLB decoded, and showed it for good to anyone
       without WebGL. */
    poster: stamp(`assets/models/gold/${key}.webp`),
    mark: stamp(`assets/marks/${key}.webp`),
    /* Built here rather than in the attribute: an object literal inside a
       template literal inside an Astro attribute loses the compiler. */
    label: catName(key, lang) + (lang === 'zh' ? '（' : ' (')
         + catNameAlt(key, lang) + (lang === 'zh' ? '）— ' : ') — ')
         + ((counts[key] ?? 0) > 0 ? t('hall.count', { n: counts[key] ?? 0 }) : t('hall.soon')),
    credit: credited[key],
  }));

/* Level with the piece, not looking down on it.
 *
 * 70° put the eye twenty degrees above the horizontal, so every drum showed its
 * top face like something on a table — while the hall behind is photographed
 * from the height of its own top step, near enough level. The two perspectives
 * did not belong to the same room.
 *
 * 98° now: eight degrees *below* the horizontal, looking a little up at the
 * piece. Worth knowing what the angle is measured from — model-viewer swings
 * the camera about camera-target, which is pinned to the origin, and the
 * origin is the middle of the assembly's box. So level means level with the
 * piece's waist, not with the drum it stands on; at 88° the drum was still
 * seen slightly from above, which is why it kept showing the top of its cap.
 *
 * And 2.6m rather than 2.2: at eye level the assembly is at its tallest on
 * screen, and anything nearer cuts the foot of the drum off. */
const CAMERA = '35deg 98deg 1.55m';
/* The camera is pinned to the origin rather than framing each model's own box,
   so every drum sits on the same line. And the radius is pinned at both ends,
   because model-viewer will not simply take the camera it is given: left to
   itself it clamps the orbit against the model's bounds — a requested 2.6m came
   back as 2.208m — so the two limits have to agree with it. */
const CAMERA_TARGET = '0m 0m 0m';
const CAMERA_LIMIT = 'auto auto 1.55m';

/*
 * The plate: the source render with the flat crown of the dome taken off the
 * top and foreground marble off the bottom, both by scripts/crop-hall.py.
 * Everything below is in per cent of it.
 */
const PLATE = { w: 836, h: 470 };
const VP = { x: 50.0, y: 69.2 };   // the horizon, on the room's axis

/* The wall, built in container units of the plate rather than px — so it is
   the same wall in the same place at every viewport, which a px perspective is
   not. Nine columns 13° apart wrap 104°, matching how far the reference wall
   turns away at its ends. */
const COLS = 9;
const ROWS = 4;
const SPREAD = 13;
const PERSP = 34;      // cqw. Short, because the photograph is a wide-angle shot
const DEPTH = 35;      // cqw back from the eye
/* the chord one 13° step subtends at that depth, less a bezel's worth, so the
   panels meet edge to edge with daylight between them */
const PANEL = 7.9;

/* How far above the horizon the foot of the wall lands, in cqw.
 *
 * Nought would be the honest answer: the top step is at eye level, so a wall
 * standing on it has its foot exactly on the horizon whatever its distance.
 * But the statues and their labels are laid out by the page, not by the room,
 * and they sit lower than the photograph's floor — a wall whose foot lands
 * among them reads as a band ruled across the labels rather than as a wall
 * behind objects. So it is raised, as a wall on a low stage would be, until it
 * clears them; the perspective itself is untouched. */
const RISE = 7.2;

/* Scaling the panel, the depth and the perspective by one factor scales what
   is drawn by exactly that factor and nothing else — same curve, same
   foreshortening, same wall, smaller. Which is what a phone needs: the plate
   has to be nearly three times the viewport's width to cover it, so a wall
   that is a third of the plate runs off both edges of the screen. */
function wall(k: number, rise: number) {
  const panel = PANEL * k, depth = DEPTH * k, persp = PERSP * k;
  const scale = persp / (persp + depth);        // how far off the eye shrinks it
  const rowH = panel * (9 / 16) * 1.04;         // cqw between row centres
  return {
    panel: panel.toFixed(2),
    z: (-depth).toFixed(2),
    persp: persp.toFixed(2),
    /* the rows are centred on the anchor; drop them by half the wall so its
       foot lands on the horizon, then lift it by the rise */
    lift: (-ROWS / 2 - rise / (rowH * scale)).toFixed(3),
  };
}
const WIDE = wall(1, RISE);
const NARROW = wall(0.62, 2.5);

const stills = lectures
  .filter((l) => l.video.guide || l.video.lecture)
  .map((l) => `https://i.ytimg.com/vi/${l.video.guide ?? l.video.lecture}/mqdefault.jpg`);

type Clip = { id: string; webm: string; mp4: string };
const reel = (clips as Clip[]).map((c) => ({ webm: asset(c.webm), mp4: asset(c.mp4) }));

const screens = Array.from({ length: COLS * ROWS }, (_, i) => {
  const col = i % COLS;
  const row = Math.floor(i / COLS);
  return {
    deg: -((COLS - 1) / 2) * SPREAD + col * SPREAD,
    row: row - (ROWS - 1) / 2,
    a: stills[i % stills.length],
    b: stills[(i + 7) % stills.length],
    delay: ((i * 2.3) % 11).toFixed(1),
    clip: reel.length ? reel[i % reel.length] : null,
  };
});
---

<section class="bh" aria-labelledby="hall-title">
  <div class="bh__scene" aria-hidden="true">
    {/* the plate holds the photograph's own aspect ratio; everything inside is
        placed in per cent of it, so a crop moves picture and screens together */}
    {/* the vanishing point travels to the script here — frontmatter constants
        do not reach a client module */}
    <div class="bh__plate" data-vp-x={VP.x} data-vp-y={VP.y}>
      <picture>
        <source srcset={asset('media/bright-hall.webp')} type="image/webp" />
        <img class="bh__photo" src={asset('media/bright-hall.jpg')} alt=""
             width={PLATE.w * 2} height={PLATE.h * 2} fetchpriority="high" decoding="async" />
      </picture>

      {/* the curved wall, standing on the top step */}
      {/* both sets of numbers are handed to the stylesheet, which picks one by
          width — an inline `--persp` could not be overridden by a media query */}
      <div class="bh__wallwrap"
           style={`--vp-x:${VP.x}%; --vp-y:${VP.y}%;
                   --persp-w:${WIDE.persp}cqw; --persp-n:${NARROW.persp}cqw`}>
        <div class="bh__wall"
             style={`--panel-w:${WIDE.panel}cqw; --z-w:${WIDE.z}cqw; --lift-w:${WIDE.lift};
                     --panel-n:${NARROW.panel}cqw; --z-n:${NARROW.z}cqw; --lift-n:${NARROW.lift}`}>
          {screens.map((s) => (
            <span class="bh__screen" style={`--deg:${s.deg}deg; --row:${s.row}; --delay:${s.delay}s`}>
              {s.clip ? (
                <video class="bh__vid" muted loop playsinline preload="none"
                       data-bh-clip={JSON.stringify(s.clip)} width="320" height="180"></video>
              ) : (
                <>
                  <img src={s.a} alt="" loading="lazy" decoding="async" width="320" height="180" />
                  <img class="b" src={s.b} alt="" loading="lazy" decoding="async" width="320" height="180" />
                </>
              )}
            </span>
          ))}
        </div>
        <span class="bh__glow"></span>
      </div>

    </div>

  </div>

  {/* Everything the hall stands still with, on one fixed layer.
      Fixed, not held by script: a transform applied on a scroll event lands a
      frame after the compositor has already moved the page, and the row of
      pieces shivered against the room all the way down. Nothing here moves at
      all now, so there is nothing left to shiver. */}
  {/* The name stands over the page, not behind it — a museum's name is the one
      thing that is never obscured by what is on show. Everything else on the
      stage stands behind. */}
  <header class="bh__lockup">
    <span class="bh__lock-rule" aria-hidden="true"></span>
    <span class="bh__uni">{t('site.university')}</span>
    <h1 id="hall-title" class="bh__title">{t('site.tagline')}</h1>
    <span class="bh__title-en" lang="en">{lang === 'zh' ? 'Nobel Lecture Museum' : '諾貝爾講座博物館'}</span>
  </header>

  <div class="bh__stage">
  {/* Each piece is named outright rather than left to be assembled from what
      is inside it. The label's characters are split into their own elements so
      each can be turned onto the drum, and inline-block spans are a known way
      to get a name read out one letter at a time. */}
    <nav class="bh__plinths" aria-label={t('hall.enter')} data-state="in">
    {cats.map((c) => (
      <a class="bh__piece" href={c.href} data-cat={c.key} aria-label={c.label}>
        <span class="bh__art">
          <model-viewer
            class="bh__mv"
            src={c.model}
            alt={t('models.alt', { what: c.credit.title, cat: c.name })}
            poster={c.poster}
            loading="lazy"
            camera-orbit={CAMERA}
            camera-target={CAMERA_TARGET}
            min-camera-orbit={CAMERA_LIMIT}
            max-camera-orbit={CAMERA_LIMIT}
            field-of-view="30deg"
            interaction-prompt="none"
            disable-zoom
            environment-image="neutral"
            exposure="1.35"
            shadow-intensity="0.55"
            shadow-softness="0.9"
            autoplay
          >
            <img class="bh__poster" slot="poster" src={c.poster} alt="" width="640" height="1280" />
          </model-viewer>
          {/* cut into the drum, where a museum puts the label — the plinth is
              part of the model, so the type is laid over its face */}
          {/* three gold rings round the drum, drawn to the logo's own height —
              filled in by the script, since only it knows where that is */}
          <svg class="bh__rings" aria-hidden="true" focusable="false"></svg>
          <span class="bh__face" aria-hidden="true">
            <img class="bh__mark" src={c.mark} alt="" width="192" height="192"
                 loading="lazy" decoding="async" />
            <span class="bh__name">{c.name}</span>
            <span class="bh__name-en">{c.nameAlt}</span>
          </span>
        </span>
        {/* On a phone the name is read here rather than off the drum — see
            the note in the media query. */}
        <span class="bh__n">
          <span class="bh__cap">{c.name}</span>
          <span class="bh__count">{c.n > 0 ? t('hall.count', { n: c.n }) : t('hall.soon')}</span>
        </span>
      </a>
    ))}
    </nav>

    <div class="bh__foot">
      <a class="bh__intro" href={gallery(lang, INTRO)} data-cat={INTRO}>
        <span class="bh__intro-txt">
          <span class="bh__eyebrow">{t('hall.nobelRoom')}</span>
          <span class="bh__intro-title">{introA}<span class="conj">{introConj}</span>{introB}</span>
          <span class="bh__intro-desc">{t('hall.introDesc')}</span>
        </span>
        <span class="bh__cta" aria-hidden="true">{t('hall.introCta')} →</span>
      </a>

      {/* The way on. A mouse with a rolling wheel is the usual drawing and it
          belongs to a different kind of site; this is the room's own idiom — a
          gold hairline with a bead of light running down it, under an arch cut
          from the same stroke as the windows behind it. */}
      <a class="bh__cue" href="#more" aria-label={t('hall.scroll')}>
        <span class="bh__cue-rule" aria-hidden="true"><i></i></span>
        <svg class="bh__cue-chev" viewBox="0 0 26 9" aria-hidden="true" focusable="false">
          <path d="M1.6 1.6 L13 7.4 L24.4 1.6" />
        </svg>
        <span class="bh__cue-txt" aria-hidden="true">{t('hall.scroll')}</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ---------- the hall's own measurements ----------
   *
   * Everything below is placed off these rather than off the flow, because the
   * flow was placing the pieces by accident: their feet landed on the room's
   * top step because the masthead above them happened to be the height it was.
   * Move the title to the corner or put a scroll cue under the row, and six
   * gold objects float an inch above a marble floor.
   *
   * So the row is anchored to the photograph. The plate is contained, so its
   * height is whichever of the two limits binds; the drum's foot is 95.7% of
   * the way down its own frame; and the line the feet land on is 76.45% of the
   * plate.
   *
   * Not the horizon, which is 69.2%. The horizon is where something *far away*
   * stands — it is the top step at the back of the room, level with the
   * threshold — and these are not far away: each draws 380px tall, which puts
   * it a few paces in front of the camera, on the near floor. Anchoring them
   * to the horizon lifted the row 58px and stood six near objects on a distant
   * step, which reads as floating however correct the line is. 76.45% is the
   * near floor at that distance, and it is where the row was composed.
   *
   * The horizon is still wanted, but for the other thing: it is the point the
   * pieces turn about when they walk in and back out, because that is where
   * the room's parallels converge whatever is standing on the floor.
   */
  .bh {
    --plate-h: min(calc(100vw * 941 / 1672), min(100svh, 62rem));
    --horizon: calc(var(--plate-h) * 0.692);
    --floor: calc(var(--plate-h) * 0.7645);
    --pad: 0.4rem;
    --row-w: calc((100vw - 4.068 * var(--pad)) / 1.161);
    --frame-w: min(24rem, calc(var(--row-w) / 6 - 2 * var(--pad)));
    --frame-h: calc(var(--frame-w) * 2);

    position: relative;
    min-block-size: min(100svh, 62rem);
    /* Not hidden. The room and its furniture are fixed and outlive this
       section by the whole document; clipping to the section cut them away
       within a screenful. The scene clips its own plate, so nothing needs
       clipping here. */
    overflow: visible;
    /* No stacking context, and no ground of its own — the body already carries
       the page's white. Both used to be here, and both had to go so that the
       three layers could be ordered against the page rather than against each
       other: the room and the pieces below what is being read (z-index 0), the
       page over them (1), and the museum's name over that (2). Isolating this
       section capped every one of them inside it. */
  }

  /* ---------- the room ---------- */
  /* Fixed, for the whole document. The hall is not this section's backdrop any
     more, it is the page's: everything below is glass, and what it is glass
     over is this. Fixed rather than held by script — there is no scroll
     arithmetic in a room that never moves, and the compositor keeps it on its
     own layer for free.
     It stays inside .bh, which isolates, so it still paints under .bh's own
     content and under the sheet below; and .bh sets no transform or filter, so
     nothing steals the containing block back off the viewport. */
  .bh__scene {
    position: fixed; inset: 0; z-index: 0; overflow: hidden;
  }

  /* The plate is the photograph's own frame, and everything in the hall is
     positioned in per cent of it — so the wall keeps its place in the
     architecture whatever size the plate ends up.

     It is contained, not covering: the whole picture is in frame at every
     viewport and nothing is ever cropped away. The cost is that the plate no
     longer fills the hero, so it is pinned to the top and the page carries on
     beneath it — which is where the picture is emptiest floor anyway. */
  .bh__plate {
    container-type: inline-size;
    position: absolute;
    inset-inline-start: 50%; inset-block-start: 0;
    translate: -50% 0;
    aspect-ratio: 1672 / 941;
    inline-size: min(100%, calc(min(100svh, 62rem) * 1672 / 941));
    block-size: auto;
  }
  /* The only wash left, and it is a join rather than a veil: the foot of the
     picture into the page, and — on a screen wide enough that the plate cannot
     reach both edges — its sides. Without them the photograph ends on a ruled
     line, because its own edges are a warm grey and the page is white. */
  .bh__plate::after {
    content: '';
    position: absolute; inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, transparent 88%, var(--bg-0) 100%),
      linear-gradient(to right, var(--bg-0), transparent 3%,
                                transparent 97%, var(--bg-0));
  }
  .bh__photo {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%;
    object-fit: cover;
  }

  /* The anchor is the measured horizon, and because the wrapper is a point
     the perspective origin lands on it too — which is the whole trick. Every
     panel is then drawn from the same eye the photograph was taken with. */
  .bh__wallwrap {
    position: absolute;
    inset-inline-start: var(--vp-x);
    inset-block-start: var(--vp-y);
    perspective: var(--persp-w);
    transform: translate(-50%, -50%);
  }
  .bh__wall {
    position: relative; inline-size: 0; block-size: 0;
    transform-style: preserve-3d;
    --panel: var(--panel-w);
    --z: var(--z-w);
    --lift: var(--lift-w);
  }
  .bh__screen {
    position: absolute;
    /* sized against the plate, not the viewport, so the wall keeps its place
       in the architecture at every crop */
    inline-size: var(--panel);
    aspect-ratio: 16 / 9;
    margin-inline-start: calc(var(--panel) / -2);
    margin-block-start: calc(var(--panel) * -9 / 32);
    /* rotateY leaves the Y axis alone, so the lift is as true in the room as
       the rows are — the wall drops, it does not tilt */
    transform:
      rotateY(var(--deg))
      translateZ(var(--z))
      translateY(calc((var(--row) + var(--lift)) * 104%));
    background: #0d1013;
    border: 1px solid #14181c;
    border-radius: 1px;
    overflow: hidden;
    /* white marble behind a black screen wants a hard edge, not a glow */
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.62),
                0 1cqw 2cqw -0.6cqw rgba(52, 40, 24, 0.28);
  }
  .bh__screen img, .bh__vid {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%; object-fit: cover;
  }
  .bh__screen .b { opacity: 0; animation: bhswap 22s var(--delay) ease-in-out infinite; }
  @keyframes bhswap { 0%, 44% { opacity: 0 } 52%, 94% { opacity: 1 } 100% { opacity: 0 } }

  /* The light the screens throw back. On a dark plate this could be strong and
     blue; on white marble anything blue reads as a stain, so it is mostly the
     shadow the wall casts down onto the top step, with only a trace of screen
     light above it. Centred on the wall, which sits above the anchor. */
  .bh__glow {
    position: absolute; inset-inline-start: 50%; inset-block-start: -6cqw;
    inline-size: 62cqw; block-size: 30cqw;
    translate: -50% -50%;
    background:
      radial-gradient(52% 56% at 50% 44%, rgba(126, 158, 196, 0.16), transparent 74%),
      radial-gradient(46% 40% at 50% 96%, rgba(74, 58, 36, 0.20), transparent 76%);
    filter: blur(10px);
    pointer-events: none;
  }

  :global(html[data-motion='off']) .bh__screen .b { animation: none; }

  /* ---------- the stage ----------
     The same box the hall used to be, but out of the flow, so the name, the
     pieces, the introduction and the cue all stand exactly still. It lets
     everything through except the three things that are meant to be clicked. */
  .bh__stage {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 0;
    block-size: min(100svh, 62rem);
    pointer-events: none;
  }
  .bh__stage > * { pointer-events: auto; }

  /* ---------- the name ----------
   *
   * A museum's name is cut into the wall by the door, not floated over the
   * middle of the room. So it is a lockup in the corner: a gold rule, the
   * university above in small caps, the name in the Han serif, the English
   * under it — the order a chiselled inscription uses, and the order the
   * printed matter of this project already uses.
   *
   * It never moves and never leaves, which is what makes the halo necessary
   * rather than decorative: the page runs under it for the whole document, so
   * the type has to hold against marble, against gold and against whatever
   * paragraph is passing. The halo is light rather than a panel — a panel in
   * the corner of a photograph reads as a sticker. */
  .bh__lockup {
    position: fixed;
    z-index: 2;
    inset-block-start: clamp(4.6rem, 9vh, 7rem);
    inset-inline-start: clamp(1.1rem, 4.2vw, 3.4rem);
    display: grid;
    justify-items: start;
    gap: 0.16rem;
    padding: 0.7rem 1.5rem 0.9rem 0;
    isolation: isolate;
    border-radius: 0.42rem;
    transition: inset-block-start 0.55s var(--ease), inset-inline-start 0.55s var(--ease),
                padding 0.55s var(--ease), background 0.4s var(--ease),
                box-shadow 0.4s var(--ease);
  }
  .bh__lockup::before { transition: opacity 0.4s var(--ease); }
  .bh__lock-rule, .bh__uni, .bh__title-en, .bh__title {
    transition: opacity 0.35s var(--ease), block-size 0.5s var(--ease),
                margin 0.5s var(--ease), font-size 0.5s var(--ease);
  }

  /* Condensed, once the hall has been left behind.
   *
   * It does not scroll — it never moves with the page — but it cannot stay a
   * display headline either: the page below carries no ground of its own, so
   * everything that comes up passes straight under it, and 本館推薦 was landing
   * inside 諾貝爾講座博物館. So the inscription becomes a mark: the rule, the
   * university and the English line fold away, the name shrinks, and it takes
   * the same frosted tablet the bar's keys wear, level with them. Coming back
   * up the page opens it out again. */
  .bh__lockup[data-small] {
    inset-block-start: 0.62rem;
    inset-inline-start: clamp(0.7rem, 2.2vw, 1.6rem);
    padding: 0.34rem 0.85rem;
    background: rgba(255, 255, 255, 0.42);
    backdrop-filter: blur(6px) saturate(1.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 0 1px rgba(255, 255, 255, 0.55),
      0 1px 2px rgba(46, 58, 78, 0.06),
      0 8px 20px -14px rgba(46, 58, 78, 0.5);
  }
  .bh__lockup[data-small]::before { opacity: 0; }
  .bh__lockup[data-small] :is(.bh__lock-rule, .bh__uni, .bh__title-en) {
    block-size: 0; opacity: 0; margin-block: 0; overflow: hidden;
  }
  .bh__lockup[data-small] .bh__title {
    font-size: var(--step-0);
    letter-spacing: 0.07em;
    text-indent: 0.07em;
    text-shadow: none;
  }
  .bh__lockup::before {
    content: '';
    position: absolute;
    inset: -1.4rem -3rem -1.6rem -2.4rem;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(58% 62% at 34% 50%,
      rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.5) 46%, transparent 78%);
  }
  /* the rule the inscription hangs from */
  .bh__lock-rule {
    inline-size: clamp(2.6rem, 7vw, 4.4rem);
    block-size: 2px;
    margin-block-end: 0.5rem;
    background: linear-gradient(to right, var(--gold-orn, #b8862a), rgba(184, 134, 42, 0.15));
  }
  .bh__uni {
    font-size: var(--step--2);
    letter-spacing: 0.34em;
    text-indent: 0.34em;          /* letter-spacing pads the right; give it back */
    color: var(--gold-orn, #b8862a);
    text-transform: uppercase;
  }
  .bh__title {
    font-family: var(--font-han-serif);
    font-size: clamp(1.72rem, 3.5vw, 3rem);
    line-height: 1.12;
    color: var(--cream);
    /* Wide for a display line, because the name is the one place the hall can
       afford the air — and because letterspaced Han is what a carved lintel
       looks like. */
    letter-spacing: 0.1em;
    text-indent: 0.1em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.9);
  }
  .bh__title-en {
    font-size: var(--step--1);
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    color: var(--muted);
    margin-block-start: 0.28rem;
  }

  /* ---------- the pieces ---------- */
  /* One row of six, set in from the walls.
   *
   * The margin at each end is meant to read as twice the space between
   * neighbours, and neither of those is a CSS length. What the eye measures is
   * drum to drum and drum to edge, and a drum fills only 67.8% of its column —
   * the rest is the air the model is framed in, plus the padding each piece
   * keeps for its focus ring. With the columns touching, that makes
   *
   *     gap    = 0.322·c + 1.356·pad
   *     margin = (W − G)/2 + 0.161·c + 0.678·pad
   *
   * for a column c in a row G across a page W. Setting margin = 2·gap and
   * substituting c = G/6 leaves G = (W − 4.068·pad) / 1.161, which is the line
   * below. Leaving the padding out of it — the first attempt — lands at 1.81
   * to 1.87 rather than 2. */
  .bh__plinths {
    /* Placed off the photograph rather than off the flow — see the note by
       .bh. The frame's foot is 95.7% of the way down it, so lifting the row by
       that much from the near floor stands the drums on it; the piece's own
       half-rem of padding comes off as well. */
    position: absolute;
    inset-inline: 0;
    margin-inline: auto;
    inset-block-start: calc(var(--floor) - 0.957 * var(--frame-h) - 0.5rem);
    inline-size: var(--row-w);
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0;
    align-items: end;
    will-change: transform;
    transition: transform 1s var(--ease), opacity 0.6s var(--ease);
  }
  .bh__piece {
    display: grid; justify-items: center; gap: 0.1rem;
    padding: 0.5rem var(--pad, 0.4rem) 0.9rem;
    text-decoration: none;
    border-radius: var(--radius);
    transition: transform 0.4s var(--ease), background 0.3s var(--ease);
  }
  /* the piece lifts; no rectangle lights up behind it — see HallModels */
  .bh__piece:hover { transform: translateY(-4px); }
  .bh__piece:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  :global(html[data-motion='off']) .bh__piece:hover { transform: none; }
  /* the room still stands still — that is the page's ground, not motion — but
     the retreat arrives rather than travels */
  :global(html[data-motion='off']) .bh__plinths,
  :global(html[data-motion='off']) .bh__piece { transition: none; }

  /* Both the arrival and the retreat turn about the room's own vanishing
     point, and neither needs measuring: the row is anchored to the horizon, so
     where the horizon falls inside it is known in advance — 95.7% of the frame
     plus the piece's padding, the same line the drums stand on. Which means no
     script has to run before the pieces are in the right place, and none has
     to run again when the window changes. */
  .bh__plinths {
    transform-origin: 50% calc(var(--horizon) - var(--floor)
                              + 0.957 * var(--frame-h) + 0.5rem);
  }

  /* Coming in: far off and small when the page opens, walking up to their
     places over a second. It is a CSS animation rather than a scripted one so
     that it cannot flash a screenful of full-size pieces before the script
     runs, and so that it still happens with no script at all. `backwards`
     rather than `forwards`: a filled animation goes on overriding the inline
     transform afterwards, and the retreat would never take. */
  .bh__plinths { animation: bh-arrive 1s var(--ease) backwards; }
  @keyframes bh-arrive {
    from { transform: scale(0.34); opacity: 0; }
    to   { transform: none; opacity: 1; }
  }
  :global(html[data-motion='off']) .bh__plinths { animation: none; }

  /* Gone back. On a desktop that is one scale about the vanishing point, which
     in a one-point perspective is exactly what walking away does. */
  .bh__plinths[data-state='back'] { transform: scale(0.5); }

  .bh__art {
    /* Portrait, not square. The piece is a tall thing in a wide box: at a
       vertical field of view the frame's height is what sets how big it draws,
       and a square box spent most of its width on air. Twice as tall is twice
       the piece, at the same column width. */
    inline-size: 100%; aspect-ratio: 1 / 2; max-inline-size: 24rem;
    display: grid; place-items: center; position: relative;
    container-type: inline-size;      /* the label is sized against the drum */
  }
  .bh__mv {
    inline-size: 100%; block-size: 100%;
    pointer-events: none;              /* the anchor owns every click */
    --poster-color: transparent;
    background: transparent;
    /* model-viewer draws a loading bar across the top of its own box, and it
       does not always clear itself once the model is in. Against a dark vault
       that never showed; on white marble it is a grey rule ruled across all six
       pieces. There is nothing for it to report anyway — the poster is already
       on screen while the model loads. */
    --progress-bar-height: 0px;
    --progress-bar-color: transparent;
  }
  .bh__poster { inline-size: 100%; block-size: 100%; object-fit: contain; }

  /* No CSS pedestal any more: every piece now carries its own, a marble drum
     merged into the model itself. Drawing a second one under it made two. */
  /* the other language, set under the first — the halls name a prize the
     same way a lecture page names its laureate */
  /* The label on the drum's face.
   *
   * Its box is measured off the model rather than guessed: at the hall's own
   * camera the marble runs from 72% to 96% of the frame's height and from 16%
   * to 84% of its width, and the middle of that is the part flat enough to
   * carry type. So the block sits on the face's centre and keeps to the
   * straight-on third; the rest is the cylinder turning away.
   *
   * It stays real text rather than being painted into the drum's texture.
   * Baked lettering would need a model per language as well as per category —
   * and it could not be selected, read aloud, or translated. */
  .bh__face {
    position: absolute;
    inset-inline: 17%;
    /* Measured on the page, at the hall's own camera: the drum's gold line
       crosses the frame at 75.7% and its foot at 95.7%, so the label has that
       near-quarter of the frame to sit in and hangs from just under the line.

       Worth measuring more than once. Two readings caught the gold cap's rim
       and then the statue itself — both gold, both wider than the inlay — and
       put the line at 54% and at 45%; the inlay is the thin wide run, one
       pixel tall and seventy-six across, and nothing else fits that. And an
       eyeballed foot at 92% was three and a half points shy of the silhouette.

       Hung from its top rather than centred, because two of the English names
       take two lines and a centred block grows upward as well as down —
       'Physiology or Medicine' put its mark back on the gold line.

       The plate is close to full. Taking a fifth off the drum took ten pixels
       out of this band, and at that point the two-line English labels wanted
       two more than were left: the mark and the second line give those back,
       so they are a shade under the fifth larger the rest are. */
    inset-block-start: 75.9%;
    display: grid;
    justify-items: center;
    gap: 0;
    text-align: center;
    text-wrap: balance;
    pointer-events: none;      /* the anchor owns every click */
    /* The drum is a cylinder, so the type on it is turned to its surface —
       see the script at the foot of this file. The perspective matches the
       model's own camera: it stands 1.55 units off an assembly whose drum is
       0.43 units across and draws 144px wide, which is 2.7 frames of distance. */
    perspective: 273cqw;
    transform-style: preserve-3d;
  }
  .bh__name, .bh__name-en { transform-style: preserve-3d; }
  /* Each word stays whole; only the characters inside it are turned.
     :global because the script builds these spans at runtime, so they never
     carry Astro's scope attribute and a plain rule matches nothing. Which is
     not cosmetic here: without `display: inline-block` they stay inline, and
     transform does not apply to a non-replaced inline element — the style is
     set, and nothing moves. Measure the rendered width, not the style string.
     Same trap as .bh__mark above. */
  .bh__face :global(.bh__word) {
    display: inline-block; white-space: nowrap; transform-style: preserve-3d;
  }
  .bh__face :global(.bh__ch) { display: inline-block; will-change: transform; }
  /* The device above the name, in the gold the hall keeps for ornament.
     :global because the mark is drawn by another component, and Astro's scope
     attribute stops at this file — a plain .bh__mark rule matches nothing and
     the SVG comes out at its natural size, filling the whole plinth. */
  /* The device above the name. Drawn by the project owner as a lit gold
     object, so it is an image rather than a glyph — and one sized by area
     rather than by width, or the tall caduceus and the wide book would carry
     quite different weight in the row. See scripts/build-marks.py. */
  /* The rings sit on the drum, under the type. Gold, and thin: the one they
     replace was a single pixel of the model. */
  .bh__rings {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%;
    pointer-events: none;
    fill: none;
    stroke: var(--gold-orn, #b8862a);
    stroke-width: 1.1;
    stroke-linecap: round;
    /* the outer tenth of each end fades, so the ring goes round the drum
       rather than stopping dead on its edge */
    mask-image: linear-gradient(to right,
      transparent 0%, #000 9%, #000 91%, transparent 100%);
  }
  .bh__mark {
    inline-size: clamp(1.4rem, 15.85cqw, 2.62rem);
    block-size: auto;
    margin-block-end: 0.1em;
  }
  .bh__name {
    font-family: var(--font-display);
    font-size: clamp(0.94rem, 9.6cqw, 1.5rem);
    line-height: 1.0;
    letter-spacing: 0.04em;
    color: var(--cream);
  }
  .bh__name-en {
    /* The second line is the one that wraps — 'Physiology or Medicine' and
       'Economic Sciences' both take two — so it carries the compromise, and
       the name above it keeps its size. */
    font-size: clamp(0.61rem, 5.2cqw, 0.93rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    color: var(--muted);
    /* one line or two, as the name needs — the two-line floor the halls use
       elsewhere would push the type off the drum's face */
    min-block-size: 0;
  }
  /* Latin set smaller than Han, which is ordinary bilingual typography rather
     than a concession: a Han character at 18px carries the weight of Latin at
     about 16. It also buys the room the two long English names need — with the
     mark a fifth larger, 'Physiology or Medicine' and 'Economic Sciences' take
     two lines that would otherwise hang three pixels past the drum's foot. */
  :global(html[lang='en']) .bh__name {
    font-size: clamp(0.82rem, 8.35cqw, 1.3rem);
  }
  .bh__piece:hover .bh__name { color: var(--accent); }
  /* Two lines' worth whether it needs them or not. The pieces are bottom
     aligned, so one column whose count wraps — 'No lectures in this category
     yet' does, in English — lifts its whole column out of line with the other
     five. Same reason .bh__name-en holds two lines. */
  .bh__n {
    font-size: var(--step--1); color: var(--muted);
    min-block-size: 2lh;
  }
  .bh__count { display: block; }
  /* the drum carries the name at this size; below, it cannot */
  .bh__cap { display: none; }

  /* ---------- the foot: the introduction, and the way on ---------- */
  .bh__foot {
    position: absolute;
    inset-inline: 0;
    inset-block-end: clamp(0.7rem, 2vh, 1.5rem);
    display: grid;
    justify-items: center;
    gap: clamp(0.5rem, 1.4vh, 0.95rem);
    /* both of these belong to the hall's first screen and go when it does */
    transition: opacity 0.55s var(--ease), visibility 0.55s var(--ease);
  }
  .bh__foot[data-gone] { opacity: 0; visibility: hidden; }

  .bh__intro {
    position: relative;
    display: flex; align-items: center; gap: clamp(0.9rem, 2.5vw, 1.8rem);
    inline-size: min(100% - 2rem, 46rem);
    margin: clamp(1.4rem, 3.5vh, 2.4rem) auto 0;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(3px);
    text-decoration: none;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .bh__intro:hover { border-color: var(--accent); background: #fff; }
  .bh__intro-txt { display: grid; gap: 0.15rem; }
  .bh__eyebrow {
    font-size: var(--step--2); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent);
  }
  .bh__intro-title { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); }
  .bh__intro-title :global(.conj) { font-size: 0.72em; opacity: 0.7; margin-inline: 0.12em; }
  .bh__intro-desc { font-size: var(--step--1); color: var(--muted); }
  .bh__cta { margin-inline-start: auto; color: var(--accent); font-size: var(--step--1); white-space: nowrap; }

  /* ---------- the way on ----------
     A hairline, a bead of light running down it, one chevron and a word. The
     bead is what carries the meaning — a mark that travels downward is read as
     'downward' before it is read as anything else — and the hairline is the
     same gold as the rule under the name, so the two ends of the screen belong
     to each other. */
  .bh__cue {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    text-decoration: none;
    padding: 0.2rem 1rem 0;
    border-radius: var(--radius);
  }
  .bh__cue-rule {
    position: relative;
    inline-size: 1px;
    block-size: clamp(1.5rem, 3.4vh, 2.3rem);
    background: linear-gradient(to bottom,
      transparent, rgba(184, 134, 42, 0.55) 30%, rgba(184, 134, 42, 0.55) 70%, transparent);
  }
  .bh__cue-rule i {
    position: absolute;
    inset-inline-start: 50%;
    inline-size: 4px; block-size: 4px;
    margin-inline-start: -2px;
    border-radius: 50%;
    background: var(--gold-bright, #d8a63c);
    box-shadow: 0 0 6px 1px rgba(216, 166, 60, 0.75);
    animation: bh-bead 2.6s var(--ease) infinite;
  }
  @keyframes bh-bead {
    0%   { inset-block-start: 0;    opacity: 0; }
    18%  { opacity: 1; }
    72%  { opacity: 1; }
    100% { inset-block-start: 100%; opacity: 0; }
  }
  .bh__cue-chev {
    inline-size: 1.05rem; block-size: auto;
    fill: none;
    stroke: var(--gold-orn, #b8862a);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }
  .bh__cue-txt {
    font-size: var(--step--2);
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    color: var(--gold-orn, #b8862a);
    text-transform: uppercase;
  }
  .bh__cue:hover .bh__cue-chev { opacity: 1; translate: 0 2px; }
  .bh__cue-chev { transition: opacity 0.3s var(--ease), translate 0.3s var(--ease); }
  :global(html[data-motion='off']) .bh__cue-rule i { animation: none; inset-block-start: 40%; }

  /* ---------- the phone ----------
   *
   * Three abreast and two deep, and the whole hall inside one screen — which
   * is an arithmetic problem, not a layout one. A 1.92:1 picture shown whole
   * across a phone is a band 220px tall; the introduction and the cue want
   * another 150; the two rows of labels another 70. What is left over is what
   * the sculptures get, and on a short phone that is not much. So the frame's
   * height is that leftover, divided by two, rather than an aspect ratio —
   * a ratio would have been correct and would not have fitted.
   *
   * Nothing is cropped: the picture is still whole, there is simply less room
   * around it. */
  @media (max-width: 48rem) {
    .bh {
      --band: calc(100vw * 941 / 1672);
      /* the near floor of the band, the same 76.45% of the picture the desktop
         row stands on — it is the same photograph */
      --floor: calc(var(--band) * 0.7645);
      --foot-h: 9.1rem;        /* the introduction and the cue, measured */
      --label-h: 3.35rem;      /* the name and the count, with their padding */
      /* The row starts inside the picture rather than under it. The sculptures
         are tall and thin, so their tops reach up into the room while the
         drums stand on the page below — which buys the height that makes them
         bigger, and reads as six pieces standing in the foreground of the
         hall rather than in a list beneath a photograph of one. */
      --top: calc(var(--band) * 0.58);
      --row-m: min(calc(100vw - 0.9rem), 30rem);
      /* Three across a 390px screen is 125px a column, and a piece is half as
         wide as it is tall — so 250px is the ceiling on how big these can be,
         and it is width that sets it, not height. (Twice the present size
         would want 260px a column, which is a 780px-wide phone.) */
      --art-h: max(5.2rem, min(calc((var(--row-m) / 3 - 2 * var(--pad)) * 2),
               calc((min(100svh, 62rem) - var(--top)
                     - var(--foot-h) - 2 * var(--label-h) - 1.2rem) / 2)));
      /* and the same, six across, for the far state */
      --back-row: min(calc(100vw - 0.5rem), 34rem);
      --back-h: calc((var(--back-row) / 6 - 0.5rem) * 2);
      padding-block: 0;
      min-block-size: 100svh;
    }
    .bh__scene { block-size: var(--band); }
    .bh__plate { inline-size: 100%; }

    /* the name sits over the picture's top-left corner, where the room is
       empty wall; the bar's keys stack down the opposite corner */
    .bh__lockup {
      inset-block-start: 0.7rem;
      inset-inline-start: 0.85rem;
      padding-block: 0.4rem 0.5rem;
    }
    .bh__lock-rule { margin-block-end: 0.34rem; }
    .bh__title { font-size: clamp(1.32rem, 7.4vw, 1.9rem); }
    .bh__title-en { font-size: 0.62rem; letter-spacing: 0.16em; text-indent: 0.16em; }

    .bh__plinths {
      inset-block-start: var(--top);
      inline-size: var(--row-m);
      grid-template-columns: repeat(3, 1fr);
      row-gap: 0.25rem;
      transform-origin: 50% calc(var(--floor) - var(--top));
    }
    /* The frame keeps its 1:2 — it is narrowed to the height it is allowed,
       rather than squashed into the column. Everything on the drum's face is
       sized in container units of this box, and those units assume the piece
       fills a frame twice as tall as it is wide; let the box go squat and
       model-viewer fits the model to the height instead, the drum draws
       narrower than the label expects, and 生理學或醫學 runs off both sides
       of its own plinth. */
    .bh__art { inline-size: min(100%, calc(var(--art-h) / 2)); }
    .bh__piece { padding: 0.25rem var(--pad) 0.35rem; }

    /* The name comes off the drum and stands under the piece.
     *
     * Everything on the drum's face is sized in container units of the frame,
     * with a floor to keep it legible on a narrow desktop — and on a phone the
     * frame is half the size, so the floor binds and the type is 58% too big
     * for the drum it is cut into: 生理學或醫學 ran off both sides of its own
     * plinth and into the line below. Sized properly it would be nine pixels,
     * which is not a label, it is a texture.
     *
     * So at this size the drum keeps its device and its rings — enough to know
     * which piece is which — and the name is set underneath where it can
     * actually be read. It is the same name; only the surface changes. */
    .bh__face .bh__name, .bh__face .bh__name-en { display: none; }
    .bh__mark { inline-size: 17cqw; margin-block-end: 0; }
    .bh__n { font-size: var(--step--2); line-height: 1.3; min-block-size: 0; }
    .bh__cap { display: block; color: var(--cream); font-weight: 500; }

    /* Gone back, on a phone: one line of six rather than the same six further
       off. Six across a 390px screen is 64px each, at which a name cut into a
       drum is a smudge — so the labels and the rings go with the distance,
       which is what distance does to lettering anyway. */
    /* Standing on the room's floor, not under it. They used to land a hundred
       pixels below the picture's bottom edge — six gold objects on a white
       page with a photograph of a hall above them. The same 76.45% line the
       desktop row stands on puts them in the room. */
    .bh__plinths[data-state='back'] {
      transform: none;
      grid-template-columns: repeat(6, 1fr);
      inline-size: var(--back-row);
      inset-block-start: calc(var(--floor) - 0.957 * var(--back-h) - 0.25rem);
    }
    .bh__plinths[data-state='back'] .bh__piece { padding-inline: 0.25rem; }
    .bh__plinths[data-state='back'] .bh__art { inline-size: 100%; }
    .bh__plinths[data-state='back'] .bh__n { display: none; }
    .bh__plinths[data-state='back'] .bh__face,
    .bh__plinths[data-state='back'] .bh__rings { opacity: 0; transition: opacity 0.5s var(--ease); }

    /* The same wall at 0.62 — see the note by wall() for why the factor is
       enough on its own. Nothing else about the wall changes. */
    .bh__wallwrap { perspective: var(--persp-n); }
    .bh__wall { --panel: var(--panel-n); --z: var(--z-n); --lift: var(--lift-n); }

    .bh__foot { gap: 0.4rem; inset-block-end: 0.55rem; }
    .bh__intro {
      inline-size: min(100% - 1rem, 30rem);
      padding: 0.45rem 0.8rem;
      gap: 0.5rem;
    }
    .bh__intro-title { font-size: var(--step-0); }
    .bh__cue-rule { block-size: 1.2rem; }
    .bh__intro-desc { display: none; }   /* the title and the call are enough here */
    .bh__cue-txt { display: none; }
  }
</style>

<script>
  import { motionOn } from '../scripts/motion';
  import '../../vendor/model-viewer.min.js';

  /* The turn is an animation in the model now, not auto-rotate — auto-rotate
     moves the camera, which swings the plinth round with the piece. So the
     motion switch plays and pauses rather than adding and removing it. */
  const viewers = [...document.querySelectorAll<HTMLElement & {
    play?: () => void; pause?: () => void;
  }>('.bh__mv')];
  function applyRotation() {
    const on = motionOn();
    for (const v of viewers) {
      if (on) { v.setAttribute('autoplay', ''); v.play?.(); }
      else { v.removeAttribute('autoplay'); v.pause?.(); }
    }
  }
  applyRotation();
  addEventListener('motionpref', applyRotation);

  /**
   * Bend the plinth labels onto the drum.
   *
   * The drum is a cylinder, and flat type laid across it reads as a sticker.
   * So each character is turned to the surface: rotated about Y by the angle
   * its own position subtends, and pushed back by how far the surface falls
   * away there. The browser's perspective does the rest — the foreshortening
   * at the ends and the slight loss of size with depth are what sell it, and
   * neither is drawn by hand.
   *
   * The angle is x / R — arc length — and not asin(x / R). That is the
   * difference between wrapping the label round the cylinder and projecting it
   * onto one, and it is the whole of what was wrong with 生理學或醫學.
   *
   * Projecting leaves each character where the layout put it and shrinks it
   * about its own centre. Two neighbours therefore both pull away from the
   * line between them, and a gap opens — w(1 − (cos θᵢ + cos θᵢ₊₁)/2) wide,
   * which at the ends of a six-character name is a fifth of a character. The
   * label stopped reading as a curve and started reading as squashed letters
   * with holes between them, worst exactly where the name is longest.
   *
   * Wrapping by arc length puts the right-hand edge of one character and the
   * left-hand edge of the next at the same arc position — but only if the
   * character is moved to where that arc position projects. Turning it in
   * place is not enough: the layout puts its centre at the arc length rθ and
   * the cylinder puts it at the chord r·sin θ, and the difference is exactly
   * the gap. So each character is also slid inward by r·sin θ − rθ, which is
   * three pixels at the ends of the longest name and nothing in the middle.
   * The line contracts by that much — 6% at this width, which is what a label
   * wrapped round a drum actually does — and it is continuous.
   *
   * The radius is measured off the model: at the label's height the drum draws
   * 144px across a 190px frame.
   *
   * How much of that depth reads as height is NOT a separate figure, and
   * treating it as one is what bent 生理學或醫學 the wrong amount. It was a
   * guessed 8° of camera tilt, which lifted the outer characters 2.2px while
   * the gold rings — drawn on the very same drum, from measured constants —
   * rise only 1.35px across the same span. The line therefore sat on a tighter
   * cylinder than the drum it is cut into, bowed two thirds too hard, and
   * kinked at the ends where the foreshortening is strongest.
   *
   * So it comes from the rings instead. A horizontal circle at height y draws
   * as an ellipse b deep, and b/R is exactly how much a unit of depth rises on
   * screen. Same two constants, same drum, by construction rather than by
   * agreement.
   *
   * They were briefly set to 0.30 and 18° on the belief that the true figures
   * were invisible. They were not invisible; they were not being applied at all,
   * because the spans this script creates never carry Astro's scope attribute
   * and so never got `display: inline-block` — and transform does nothing to a
   * non-replaced inline element. Tune against the rendered width, never against
   * the style string.
   *
   * Progressive: if this never runs, the labels are simply flat.
   */
  const DRUM_R = 0.379;        // of the frame's width, measured
  /* No character turns further than this. The type is set with a clamp, so at
     narrow widths its floor binds while the frame goes on shrinking and the
     line takes a larger share of the drum: at 1120px the ends were turning 71°
     and drawing at a third of their width. Where a line would overrun, the
     curve is worked on a wider radius instead — the same shape, opened out. */
  const MAX_TURN = (55 * Math.PI) / 180;

  /**
   * The pieces step back, once.
   *
   * Everything about where they stand is in the stylesheet — the row is
   * anchored to the photograph's own horizon and turns about its vanishing
   * point, so nothing here has to measure anything, and nothing has to run
   * again when the window changes. What is left for a script is the cue: at
   * what point on the page the six withdraw.
   *
   * A desktop's is two notches of a wheel. A wheel notch is 100px nearly
   * everywhere, so it is 200px — far enough that a nudge does not fire it, and
   * near enough that it happens while the hall is still the thing being looked
   * at. A phone has no wheel and a much shorter screen, so it is a fifth of the
   * window instead.
   *
   * And what they withdraw *to* differs. On a desktop the six stay a row of
   * six and simply go further off. On a phone they are three abreast and two
   * deep, and the far version is a single line of six — a different grid, not
   * a smaller one, which no property can tween. So the pieces are carried from
   * where they were to where they now are: measure, relayout, put each one
   * back where it started, then let go. The browser animates the rest.
   */
  const ROOM = matchMedia('(min-width: 48rem)');
  const WHEEL = 200;          // two notches
  const SHARE = 0.2;          // or a fifth of a phone's screen

  const plinths = document.querySelector<HTMLElement>('.bh__plinths');
  const foot = document.querySelector<HTMLElement>('.bh__foot');
  const lockup = document.querySelector<HTMLElement>('.bh__lockup');
  const pieces = [...document.querySelectorAll<HTMLElement>('.bh__piece')];

  let back: boolean | null = null;

  /** carry each piece from where it was to where it now is */
  function flip(before: DOMRect[]) {
    const after = pieces.map((p) => p.getBoundingClientRect());
    pieces.forEach((p, i) => {
      const dx = before[i].left - after[i].left;
      const dy = before[i].top - after[i].top;
      const k = after[i].width ? before[i].width / after[i].width : 1;
      p.style.transition = 'none';
      p.style.transformOrigin = 'top left';
      p.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px) scale(${k.toFixed(4)})`;
    });
    void plinths!.offsetWidth;
    for (const p of pieces) {
      p.style.transition = 'transform 1s var(--ease)';
      p.style.transform = '';
    }
    /* hand the piece back to the stylesheet, or the hover lift inherits this
       transition and takes a second to happen */
    setTimeout(() => {
      for (const p of pieces) { p.style.transition = ''; p.style.transformOrigin = ''; }
    }, 1050);
  }

  function setBack(v: boolean, animate: boolean) {
    if (!plinths || v === back) return;
    const wide = ROOM.matches;
    const before = animate && !wide ? pieces.map((p) => p.getBoundingClientRect()) : null;
    back = v;
    plinths.dataset.state = v ? 'back' : 'in';
    foot?.toggleAttribute('data-gone', v);
    lockup?.toggleAttribute('data-small', v);
    if (before) flip(before);
  }

  function step(animate = true) {
    setBack(scrollY >= (ROOM.matches ? WHEEL : innerHeight * SHARE), animate);
  }

  if (plinths) {
    /* whatever the page was restored at, the first state is simply the state */
    step(false);
    let ticking = false;
    addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { step(); ticking = false; });
    }, { passive: true });
    /* crossing the width changes both the cue and the shape of the far state,
       so the row is put back and re-decided from scratch */
    ROOM.addEventListener('change', () => {
      for (const p of pieces) { p.style.transition = 'none'; p.style.transform = ''; }
      back = null;
      step(false);
      requestAnimationFrame(() => { for (const p of pieces) p.style.transition = ''; });
    });
  }

  const faces = [...document.querySelectorAll<HTMLElement>('.bh__face')];

  /** split once, into words that stay whole and characters that can turn */
  function split(line: HTMLElement) {
    if (line.dataset.flat !== undefined) return;
    const text = line.textContent ?? '';
    line.dataset.flat = text;
    line.replaceChildren(...text.split(/(\s+)/).map((token) => {
      if (!token.trim()) return document.createTextNode(token);
      const word = document.createElement('span');
      word.className = 'bh__word';
      word.append(...[...token].map((ch) => {
        const c = document.createElement('span');
        c.className = 'bh__ch';
        c.textContent = ch;
        return c;
      }));
      return word;
    }));
  }

  /**
   * Three gold rings round the drum, set to the logo rather than to the model.
   *
   * They replace the single ring the base model carried, which sat under the
   * cap and had no relation to anything on the plinth. These take their height
   * from the logo itself — one on its centre line and one a quarter of its
   * height above and below — so they cannot drift when the type is resized.
   *
   * Each is a horizontal circle on the drum, so it draws as an ellipse: full
   * width across the drum, and as deep as its distance below the eye.
   *
   * Both constants are solved from two of the drum's own ellipses rather than
   * guessed at one. Its foot is 13.8px deep at 95.7% of the frame; its top
   * circle, four times nearer the eye in the model, is 3.4px deep at 72.4%.
   * Two depths at two heights give the slope, 0.1168, and where the ellipse
   * would close, 0.646. Reading the eye off the foot alone put it at 0.726 and
   * the rings came out half as deep as they should be.
   *
   * And each is broken where the logo crosses it, by 140% of the logo's width,
   * so the mark sits in a clearing rather than on top of a line.
   */
  const EYE = 0.646;           // of the frame's height, where the drum is edge-on
  const ELLIPSE = 0.1168;      // how fast the ellipse opens below that
  /* the arcs stop just short of the silhouette and fade into it — a ring runs
     out of drum there, and a stroke ending on the edge looks like it overshoots */
  const RING_REACH = 0.985;
  const RING_GAP = 1.4;        // of the logo's width
  /* of the logo's height, between the rings. A quarter to begin with; nine
     tenths of that reads as a set of three rather than as three separate
     lines. */
  const RING_STEP = 0.225;

  function drawRings(face: HTMLElement, frame: HTMLElement) {
    const svg = frame.querySelector<SVGSVGElement>('.bh__rings');
    const mark = face.querySelector<HTMLElement>('.bh__mark');
    if (!svg || !mark) return;
    const f = frame.getBoundingClientRect();
    const m = mark.getBoundingClientRect();
    if (!f.width || !m.height) return;

    svg.setAttribute('viewBox', `0 0 ${f.width} ${f.height}`);
    const cx = f.width / 2;
    const R = f.width * DRUM_R;
    const half = (m.width * RING_GAP) / 2;
    const mid = m.top + m.height / 2 - f.top;
    const step = m.height * RING_STEP;

    /* where the gap's edge meets the ellipse, as a fraction of its depth */
    const k = half < R ? Math.sqrt(1 - (half / R) ** 2) : 0;

    /* Solve for each ring's height *on the drum*, rather than drawing it at
       the height we want to see it.
       Only the near half of a ring is on the drum's front, so what is drawn
       hangs below the height it belongs to: where the gap cuts it, at x = half,
       it has already sagged by b·k. Setting y to the logo's centre therefore
       put the visible arc a whole b·k under it — six pixels, a fifth of the
       logo — which is the low reading. Inverting it is one line, and b is
       itself a function of y, so it has to be solved rather than subtracted. */
    const eye = f.height * EYE;
    const solve = (t: number) => (t + eye * ELLIPSE * k) / (1 + ELLIPSE * k);

    const d: string[] = [];
    for (const t of [mid - step, mid, mid + step]) {
      const y = solve(t);
      const b = Math.max(0.2, (y - eye) * ELLIPSE);
      const drop = b * k;
      const reach = R * RING_REACH;
      const edge = y + b * Math.sqrt(Math.max(0, 1 - RING_REACH ** 2));
      d.push(`M${(cx - reach).toFixed(1)} ${edge.toFixed(1)}`
           + `A${R.toFixed(1)} ${b.toFixed(2)} 0 0 0 ${(cx - half).toFixed(1)} ${(y + drop).toFixed(1)}`);
      d.push(`M${(cx + half).toFixed(1)} ${(y + drop).toFixed(1)}`
           + `A${R.toFixed(1)} ${b.toFixed(2)} 0 0 0 ${(cx + reach).toFixed(1)} ${edge.toFixed(1)}`);
    }
    svg.replaceChildren(...d.map((path) => {
      const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      el.setAttribute('d', path);
      return el;
    }));
  }

  function curve() {
    for (const face of faces) {
      const frame = face.parentElement;
      if (!frame) continue;
      const fr = frame.getBoundingClientRect();
      const R = fr.width * DRUM_R;
      if (!(R > 0)) continue;
      drawRings(face, frame);
      for (const line of face.querySelectorAll<HTMLElement>('.bh__name, .bh__name-en')) {
        split(line);
        const chars = [...line.querySelectorAll<HTMLElement>('.bh__ch')];
        if (!chars.length) continue;

        /* Clear every one before measuring any. A transformed element reports
           its transformed box, so measuring as we go made each character's
           angle depend on the ones already turned — wrong the second time this
           runs, which is after the fonts land. */
        for (const ch of chars) ch.style.transform = '';
        const mid = line.getBoundingClientRect();
        const cx = mid.left + mid.width / 2;
        const dx = chars.map((ch) => {
          const b = ch.getBoundingClientRect();
          return b.left + b.width / 2 - cx;
        });

        const reach = Math.max(...dx.map(Math.abs), 1);
        const r = Math.max(R, reach / MAX_TURN);

        /* How steeply this line's own circle opens, in the ring's own terms:
           b at this height, over the radius it is worked on. At the Han name's
           height that is about 0.085 — under 5°, not the 8° that was assumed. */
        const b = Math.max(0, (mid.top + mid.height / 2 - fr.top - fr.height * EYE) * ELLIPSE);
        const rise = b / r;

        chars.forEach((ch, i) => {
          const th = dx[i] / r;          // arc length, not projection
          /* how far the surface falls away behind the label's own plane */
          const back = r * (1 - Math.cos(th));
          /* and that depth reads on screen as exactly the sag the rings have */
          const lift = back * rise;
          /* arc length in, chord out — the slide that keeps the line closed */
          const slide = r * Math.sin(th) - dx[i];
          ch.style.transform =
            `translate3d(${slide.toFixed(2)}px, ${-lift.toFixed(2)}px, ${-back.toFixed(2)}px) ` +
            `rotateY(${((th * 180) / Math.PI).toFixed(2)}deg)`;
        });
      }
    }
  }

  if (faces.length) {
    const run = () => requestAnimationFrame(curve);
    document.fonts?.ready.then(run) ?? run();
    run();
    /* the row carries a scale once the page moves, and getBoundingClientRect
       reports it — so the labels are measured at the top of the page and left
       alone after that */
    /* the labels are sized in container units, so they move with the row */
    let t: ReturnType<typeof setTimeout>;
    addEventListener('resize', () => { clearTimeout(t); t = setTimeout(run, 120); });
  }
  /* model-viewer has no animation to play until the GLB is in */
  for (const v of viewers) v.addEventListener('load', applyRotation);

  /* Only the middle of the wall gets a decoder if clips ever land — thirty-six
     simultaneous videos is not a backdrop, it is a stress test. */
  const screens = [...document.querySelectorAll<HTMLVideoElement>('.bh__vid')];
  if (screens.length && motionOn()) {
    const mid = screens.length / 2;
    screens.forEach((v, i) => {
      if (Math.abs(i - mid) > 4) return;
      const c = JSON.parse(v.dataset.bhClip ?? 'null');
      if (!c) return;
      const webm = document.createElement('source');
      webm.src = c.webm; webm.type = 'video/webm';
      const mp4 = document.createElement('source');
      mp4.src = c.mp4; mp4.type = 'video/mp4';
      v.append(webm, mp4);
      v.load();
      v.play().catch(() => {});
    });
  }
</script>
