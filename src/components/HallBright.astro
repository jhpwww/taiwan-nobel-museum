---
/**
 * HallBright.astro — the bright museum's entrance.
 *
 * Two references, combined as asked: the neoclassical hall — white marble,
 * gold-edged coffers, a balustrade running round a mezzanine, a radial
 * medallion set into the floor — and the curved multi-row video wall, which
 * stands where that hall's far doorway was. Six gold pieces are set out in
 * front of it on plinths, in the row the objects hall already uses.
 *
 * Built the way the room hall is built: real CSS 3D, one perspective, every
 * plane at a genuine Z. Nothing here is an image of a room; the coffers
 * recede because they are rotated, and the wall curves because each panel
 * is turned on its own axis.
 *
 * No drifting embers. They belonged to a dark vault, and on marble they read
 * as dirt. What moves here is daylight: two slow shafts crossing the floor,
 * and dust visible only inside them.
 */
import StyleSwitch from './StyleSwitch.astro';
import MotionToggle from './MotionToggle.astro';
import { useT, type Lang } from '../i18n/ui';
import { gallery, asset } from '../i18n/routing';
import { lectures, catName, categoryList, introParts, INTRO } from '../data/catalog';
import credits from '../../data/model-credits.json';
import clips from '../data/backdrop.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const counts = lectures.reduce<Record<string, number>>((a, l) => {
  a[l.prize.category] = (a[l.prize.category] ?? 0) + 1;
  return a;
}, {});
const [introA, introConj, introB] = introParts(lang);

type Credit = { title: string; author: string; licence: string; page: string; source?: string };
const credited = credits as Record<string, Credit>;

const cats = categoryList()
  .map((c) => c.key)
  .filter((k) => k in credited)
  .map((key) => ({
    key,
    name: catName(key, lang),
    n: counts[key] ?? 0,
    href: gallery(lang, key),
    model: asset(`assets/models/gold/${key}.glb`),
    poster: asset(`assets/models/${key}.webp`),
    credit: credited[key],
  }));

const CAMERA = '35deg 70deg 2.2m';

/*
 * The hall is the photograph, not a drawing of one. Its perspective was
 * measured rather than guessed: a Hough transform over the receding lines —
 * coffers, cornices, the floor medallion, the balustrades — and a
 * least-squares intersection of all 136 of them put the vanishing point at
 * 49.3% across and 58.6% down. That lands exactly on the far doorway, which
 * is where a wall of screens would stand.
 *
 * The wall is positioned in those same fractions, inside a plate that carries
 * the photograph's aspect ratio, so as the viewport crops the picture the two
 * crop together and the screens never drift off the doorway.
 */
/* the picture with its ceiling cropped away — see scripts note in the commit;
   the vanishing point moves with the crop, from 58.6% down to 48.2% */
const PLATE = { w: 738, h: 326 };
const VP = { x: 49.3, y: 48.2 };   // per cent of the plate

/* Nine columns at 13° wrap 104° — a good deal rounder than the 72° it had,
   and matching how far the reference wall turns away at its ends. */
const COLS = 9;
const ROWS = 4;
const SPREAD = 13;

const stills = lectures
  .filter((l) => l.video.guide || l.video.lecture)
  .map((l) => `https://i.ytimg.com/vi/${l.video.guide ?? l.video.lecture}/mqdefault.jpg`);

type Clip = { id: string; webm: string; mp4: string };
const reel = (clips as Clip[]).map((c) => ({ webm: asset(c.webm), mp4: asset(c.mp4) }));

const screens = Array.from({ length: COLS * ROWS }, (_, i) => {
  const col = i % COLS;
  const row = Math.floor(i / COLS);
  return {
    deg: -((COLS - 1) / 2) * SPREAD + col * SPREAD,
    row: row - (ROWS - 1) / 2,
    a: stills[i % stills.length],
    b: stills[(i + 7) % stills.length],
    delay: ((i * 2.3) % 11).toFixed(1),
    clip: reel.length ? reel[i % reel.length] : null,
  };
});
---

<section class="bh" aria-labelledby="hall-title">
  <StyleSwitch lang={lang} current="bright" />
  <MotionToggle lang={lang} />

  <div class="bh__scene" aria-hidden="true">
    {/* the plate holds the photograph's own aspect ratio; everything inside is
        placed in per cent of it, so a crop moves picture and screens together */}
    <div class="bh__plate">
      <picture>
        <source srcset={asset('media/bright-hall.webp')} type="image/webp" />
        <img class="bh__photo" src={asset('media/bright-hall.jpg')} alt=""
             width={PLATE.w * 2} height={PLATE.h * 2} fetchpriority="high" decoding="async" />
      </picture>

      {/* the curved wall, standing in the far doorway */}
      <div class="bh__wallwrap">
        <div class="bh__wall">
          {screens.map((s) => (
            <span class="bh__screen" style={`--deg:${s.deg}deg; --row:${s.row}; --delay:${s.delay}s`}>
              {s.clip ? (
                <video class="bh__vid" muted loop playsinline preload="none"
                       data-bh-clip={JSON.stringify(s.clip)} width="320" height="180"></video>
              ) : (
                <>
                  <img src={s.a} alt="" loading="lazy" decoding="async" width="320" height="180" />
                  <img class="b" src={s.b} alt="" loading="lazy" decoding="async" width="320" height="180" />
                </>
              )}
            </span>
          ))}
        </div>
        <span class="bh__glow"></span>
      </div>

      {/* dust in the daylight the hall already has — no shafts of my own, the
          photograph brings its own light */}
      <div class="bh__dust">
        {Array.from({ length: 18 }, (_, i) => (
          <span style={`--x:${(i * 37) % 100}%; --y:${(i * 53) % 74}%; --d:${16 + (i % 6) * 3}s; --s:${0.5 + (i % 4) * 0.3}`}></span>
        ))}
      </div>
    </div>

    <span class="bh__veil"></span>
  </div>

  <div class="bh__masthead">
    <h1 id="hall-title" class="bh__title">{t('site.tagline')}</h1>
    <p class="bh__hint">{t('hall.hint')}</p>
  </div>

  <nav class="bh__plinths" aria-label={t('hall.enter')}>
    {cats.map((c) => (
      <a class="bh__piece" href={c.href} data-cat={c.key}>
        <span class="bh__art">
          <model-viewer
            class="bh__mv"
            src={c.model}
            alt={t('models.alt', { what: c.credit.title, cat: c.name })}
            poster={c.poster}
            loading="lazy"
            camera-orbit={CAMERA}
            field-of-view="30deg"
            interaction-prompt="none"
            disable-zoom
            environment-image="neutral"
            exposure="1.35"
            shadow-intensity="0.55"
            shadow-softness="0.9"
            auto-rotate
            auto-rotate-delay="0"
            rotation-per-second="14deg"
          >
            <img class="bh__poster" slot="poster" src={c.poster} alt="" width="512" height="512" />
          </model-viewer>
        </span>
        <span class="bh__plinth" aria-hidden="true"></span>
        <span class="bh__name">{c.name}</span>
        <span class="bh__n">{c.n > 0 ? t('hall.count', { n: c.n }) : t('hall.soon')}</span>
      </a>
    ))}
  </nav>

  <a class="bh__intro" href={gallery(lang, INTRO)} data-cat={INTRO}>
    <span class="bh__intro-txt">
      <span class="bh__eyebrow">{t('hall.nobelRoom')}</span>
      <span class="bh__intro-title">{introA}<span class="conj">{introConj}</span>{introB}</span>
      <span class="bh__intro-desc">{t('hall.introDesc')}</span>
    </span>
    <span class="bh__cta" aria-hidden="true">{t('hall.introCta')} →</span>
  </a>
</section>

<style>
  .bh {
    position: relative;
    min-block-size: min(100svh, 62rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    padding-block: max(clamp(1.5rem, 4vh, 3.5rem), 4.4rem) clamp(2rem, 5vh, 4rem);
    overflow: hidden;
    isolation: isolate;
    background:
      linear-gradient(to bottom, #ffffff 0%, #faf8f4 42%, #f0ebe2 100%);
  }

  /* ---------- the room ---------- */
  .bh__scene { position: absolute; inset: 0; z-index: -1; overflow: hidden; }

  /* The plate is the photograph's own frame. It is made to cover the scene
     while keeping its aspect ratio, and everything in the hall is positioned
     in per cent of it — so when the viewport crops the picture, the screens
     are cropped with it and stay in the doorway. */
  .bh__plate {
    container-type: inline-size;
    position: absolute;
    inset-inline-start: 50%; inset-block-start: 50%;
    translate: -50% -50%;
    aspect-ratio: 738 / 326;
    inline-size: max(100%, calc(100vh * 738 / 326));
    block-size: auto;
    min-block-size: 100%;
  }
  .bh__photo {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%;
    object-fit: cover;
  }

  /* white wash: the photograph is busier than a drawn room, and the type has
     to sit on it */
  .bh__veil {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to bottom,
        rgba(255, 255, 255, 0.62) 0%,
        rgba(255, 255, 255, 0.30) 26%,
        rgba(255, 255, 255, 0.34) 58%,
        rgba(255, 255, 255, 0.86) 92%,
        var(--bg-0) 100%);
  }

  /* the wall stands at the photograph's vanishing point */
  .bh__wallwrap {
    position: absolute;
    inset-inline-start: 49.3%;
    /* The vanishing point is the wall's anchor, but a wall stands *on* the
       floor rather than hanging centred on the horizon, so it is lifted by
       half its own height — and further still, clear of the statues' heads.
       Sitting level with them read as one flat band rather than as a wall
       behind objects. */
    inset-block-start: 40%;
    perspective: 900px;
    transform: translate(-50%, -50%);
  }
  .bh__wall {
    position: relative; inline-size: 0; block-size: 0;
    transform-style: preserve-3d;
  }
  .bh__screen {
    position: absolute;
    /* sized against the plate, not the viewport, so the wall keeps its place
       in the architecture at every crop */
    inline-size: 6.5cqw;
    aspect-ratio: 16 / 9;
    margin-inline-start: -3.25cqw;
    margin-block-start: -1.83cqw;
    transform: rotateY(var(--deg)) translateZ(-15.5cqw) translateY(calc(var(--row) * 104%));
    background: #0d1013;
    border: 1px solid #14181c;
    border-radius: 1px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.5);
  }
  .bh__screen img, .bh__vid {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%; object-fit: cover;
  }
  .bh__screen .b { opacity: 0; animation: bhswap 22s var(--delay) ease-in-out infinite; }
  @keyframes bhswap { 0%, 44% { opacity: 0 } 52%, 94% { opacity: 1 } 100% { opacity: 0 } }

  /* the light the screens throw back into the hall */
  .bh__glow {
    position: absolute; inset-inline-start: 50%; inset-block-start: 50%;
    inline-size: 46cqw; block-size: 26cqw;
    translate: -50% -50%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(150, 190, 235, 0.30), transparent 72%);
    filter: blur(14px);
    pointer-events: none;
  }

  .bh__dust { position: absolute; inset: 0; pointer-events: none; }
  .bh__dust span {
    position: absolute;
    inset-inline-start: var(--x); inset-block-start: var(--y);
    inline-size: 4px; block-size: 4px; border-radius: 50%;
    background: rgba(255, 253, 244, 0.9);
    box-shadow: 0 0 7px 2px rgba(255, 246, 218, 0.55);
    transform: scale(var(--s));
    animation: bhdust var(--d) linear infinite;
  }
  @keyframes bhdust {
    0%   { transform: translate3d(0, 0, 0) scale(var(--s)); opacity: 0 }
    14%  { opacity: 0.8 }
    86%  { opacity: 0.45 }
    100% { transform: translate3d(26px, -130px, 0) scale(var(--s)); opacity: 0 }
  }

  :global(html[data-motion='off']) .bh__dust span,
  :global(html[data-motion='off']) .bh__screen .b { animation: none; }

  /* ---------- masthead ---------- */
  .bh__masthead { text-align: center; padding-inline: 1rem; position: relative; }
  .bh__title {
    font-family: var(--font-han-serif);
    font-size: var(--step-4);
    color: var(--cream);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.85);
  }
  .bh__hint {
    font-size: var(--step--1); color: var(--muted);
    margin: 0.5rem auto 0; max-inline-size: none;
    /* the wall can end up behind this line at narrow widths; the halo keeps it
       legible whatever it lands on */
    text-shadow: 0 0 6px #fff, 0 0 12px #fff;
  }

  /* ---------- the pieces ---------- */
  .bh__plinths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: clamp(0.6rem, 2vw, 1.4rem);
    align-items: end;
    inline-size: min(100% - 2rem, 80rem);
    margin: clamp(1.2rem, 3.5vh, 2.6rem) auto 0;
    position: relative;
  }
  .bh__piece {
    display: grid; justify-items: center; gap: 0.1rem;
    padding: 0.5rem 0.4rem 0.9rem;
    text-decoration: none;
    border-radius: var(--radius);
    transition: transform 0.4s var(--ease), background 0.3s var(--ease);
  }
  /* the piece lifts; no rectangle lights up behind it — see HallModels */
  .bh__piece:hover { transform: translateY(-4px); }
  .bh__piece:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  :global(html[data-motion='off']) .bh__piece:hover { transform: none; }

  .bh__art {
    inline-size: 100%; aspect-ratio: 1; max-inline-size: 11rem;
    display: grid; place-items: center; position: relative;
  }
  .bh__mv {
    inline-size: 100%; block-size: 100%;
    pointer-events: none;              /* the anchor owns every click */
    --poster-color: transparent;
    background: transparent;
  }
  .bh__poster { inline-size: 100%; block-size: 100%; object-fit: contain; }

  /* a marble pedestal, lit from the front */
  .bh__plinth {
    inline-size: min(72%, 8rem); block-size: 0.85rem;
    border-radius: 3px 3px 1px 1px;
    background: linear-gradient(to bottom, #ffffff, #e9e3d6 60%, #d8d0be);
    box-shadow: 0 6px 14px -6px rgba(60, 50, 34, 0.4);
  }
  .bh__name {
    font-family: var(--font-han-serif);
    font-size: var(--step-0); color: var(--cream);
    margin-block-start: 0.55rem;
  }
  .bh__piece:hover .bh__name { color: var(--accent); }
  .bh__n { font-size: var(--step--1); color: var(--muted); }

  /* ---------- introduction ---------- */
  .bh__intro {
    display: flex; align-items: center; gap: clamp(0.9rem, 2.5vw, 1.8rem);
    inline-size: min(100% - 2rem, 46rem);
    margin: clamp(1.4rem, 3.5vh, 2.4rem) auto 0;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(3px);
    text-decoration: none;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .bh__intro:hover { border-color: var(--accent); background: #fff; }
  .bh__intro-txt { display: grid; gap: 0.15rem; }
  .bh__eyebrow {
    font-size: var(--step--2); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent);
  }
  .bh__intro-title { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); }
  .bh__intro-title :global(.conj) { font-size: 0.72em; opacity: 0.7; margin-inline: 0.12em; }
  .bh__intro-desc { font-size: var(--step--1); color: var(--muted); }
  .bh__cta { margin-inline-start: auto; color: var(--accent); font-size: var(--step--1); white-space: nowrap; }

  @media (max-width: 48rem) {
    .bh__plinths { grid-template-columns: repeat(2, 1fr); }

    /* On a phone the pieces stack three rows deep, so a room drawn over the
       whole column ends up with a video wall sitting across the labels. The
       architecture is held to the first screen and faded out below it. */
    .bh__scene { block-size: 64svh; }
    .bh__scene::after {
      content: '';
      position: absolute; inset-inline: 0; inset-block-end: 0;
      block-size: 38%;
      background: linear-gradient(to bottom, transparent, var(--bg-0) 88%);
    }
    /* two rows, not four: at this width a four-row wall reaches up into the
       masthead and the title becomes unreadable over the screens */
    .bh__screen:nth-child(-n + 9),
    .bh__screen:nth-child(n + 28) { display: none; }
    /* the panel clamp bottoms out at 88px, which is wider than this viewport
       wants; below 48rem the wall is sized directly */
    .bh__screen {
      inline-size: 62px;
      margin-inline-start: -31px;
      margin-block-start: -17px;
      transform: rotateY(var(--deg)) translateZ(-190px) translateY(calc(var(--row) * 104%));
    }
    /* set into the gap between the masthead and the first pieces, so it backs
       the room without crossing the title */
    .bh__wallwrap { inset-block-start: 50%; }
    /* the wall is built for a wide room; on a phone only the middle is seen */
    .bh__screen { inline-size: 116px; block-size: 65px; margin: -32px -58px; }
    .bh__ceiling { grid-template-columns: repeat(4, 1fr); }
    .bh__intro { flex-wrap: wrap; }
    .bh__cta { margin-inline-start: 0; }
  }
  @media (max-width: 34rem) {
    .bh { padding-block-start: 8.7rem; }
  }
</style>

<script>
  import { motionOn } from '../scripts/motion';
  import '../../vendor/model-viewer.min.js';

  const viewers = [...document.querySelectorAll<HTMLElement>('.bh__mv')];
  function applyRotation() {
    for (const v of viewers) {
      if (motionOn()) v.setAttribute('auto-rotate', '');
      else v.removeAttribute('auto-rotate');
    }
  }
  applyRotation();
  addEventListener('motionpref', applyRotation);

  /* Only the middle of the wall gets a decoder if clips ever land — thirty-six
     simultaneous videos is not a backdrop, it is a stress test. */
  const screens = [...document.querySelectorAll<HTMLVideoElement>('.bh__vid')];
  if (screens.length && motionOn()) {
    const mid = screens.length / 2;
    screens.forEach((v, i) => {
      if (Math.abs(i - mid) > 4) return;
      const c = JSON.parse(v.dataset.bhClip ?? 'null');
      if (!c) return;
      const webm = document.createElement('source');
      webm.src = c.webm; webm.type = 'video/webm';
      const mp4 = document.createElement('source');
      mp4.src = c.mp4; mp4.type = 'video/mp4';
      v.append(webm, mp4);
      v.load();
      v.play().catch(() => {});
    });
  }
</script>
