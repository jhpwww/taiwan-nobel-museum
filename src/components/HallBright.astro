---
/**
 * HallBright.astro — the bright museum's entrance.
 *
 * A domed neoclassical rotunda — white marble, a glazed dome, a ring of arched
 * windows, two red banners — with a curved video wall standing in the apse and
 * six gold pieces set out on the floor in front of it.
 *
 * The hall is a photograph, so the wall's placement is measured, not guessed.
 * It has to be: the wall is positioned in per cent of a plate that carries the
 * picture's own aspect ratio, so picture and wall crop together and the wall
 * never drifts off the architecture.
 *
 * Finding the eye level took a second method. A Hough transform over every
 * receding line — how the previous plate was measured — answers 43% here and
 * is wrong: in a rotunda most of what it finds are dome ribs, and those
 * converge on the dome's own axis rather than the room's horizon. But a
 * rotunda gives up its horizon another way. Its 'horizontal' lines are
 * circles, and a circle photographs as a straight line only when the camera's
 * eye is at its height. Fit the rings — dome ring, entablature, step nosing,
 * step foot — and read off where their curvature changes sign. The entablature
 * dips in the middle (seen from below), the floor rises (seen from above), and
 * between them the step nosing is dead flat. The eye is level with the top
 * step, 68.6% down the plate. See scripts/crop-hall.py.
 *
 * So the wall stands on that top step, its base exactly on the horizon, rising
 * to just under the doorway's arch — which is where a wall of screens would
 * stand in this room, and leaves the colonnade and the dome above it intact.
 *
 * No drifting embers, and no dust either. Embers belonged to a dark vault and
 * read as dirt on marble; motes are invisible against a hall this bright. The
 * light in this room is the photograph's own.
 */
import StyleSwitch from './StyleSwitch.astro';
import MotionToggle from './MotionToggle.astro';
import { useT, type Lang } from '../i18n/ui';
import { gallery, asset } from '../i18n/routing';
import { lectures, catName, catNameAlt, categoryList, introParts, INTRO } from '../data/catalog';
import credits from '../../data/model-credits.json';
import clips from '../data/backdrop.json';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const counts = lectures.reduce<Record<string, number>>((a, l) => {
  a[l.prize.category] = (a[l.prize.category] ?? 0) + 1;
  return a;
}, {});
const [introA, introConj, introB] = introParts(lang);

type Credit = { title: string; author: string; licence: string; page: string; source?: string };
const credited = credits as Record<string, Credit>;

/**
 * Anything under public/ keeps its URL forever, so a redeployed model sits
 * behind whatever the visitor already cached — GitHub Pages serves these with
 * max-age=600, and a swapped piece simply does not appear. Astro fingerprints
 * what it bundles; these it does not, so they are fingerprinted here, the same
 * way the objects hall does it.
 */
const stamp = (rel: string) => {
  const hash = createHash('sha256')
    .update(readFileSync(new URL(`../../public/${rel}`, import.meta.url)))
    .digest('hex').slice(0, 8);
  return `${asset(rel)}?v=${hash}`;
};

const cats = categoryList()
  .map((c) => c.key)
  .filter((k) => k in credited)
  .map((key) => ({
    key,
    name: catName(key, lang),
    nameAlt: catNameAlt(key, lang),
    n: counts[key] ?? 0,
    href: gallery(lang, key),
    model: stamp(`assets/models/gold/${key}.glb`),
    /* the gold poster, not the other museum's. This hall showed the dark
       museum's palette until its GLB decoded, and showed it for good to anyone
       without WebGL. */
    poster: stamp(`assets/models/gold/${key}.webp`),
    credit: credited[key],
  }));

const CAMERA = '35deg 70deg 2.2m';

/*
 * The plate: the source render with the flat crown of the dome taken off the
 * top and foreground marble off the bottom, both by scripts/crop-hall.py.
 * Everything below is in per cent of it.
 */
const PLATE = { w: 836, h: 435 };
const VP = { x: 50.1, y: 64.3 };   // the horizon, on the room's axis

/* The wall, built in container units of the plate rather than px — so it is
   the same wall in the same place at every viewport, which a px perspective is
   not. Nine columns 13° apart wrap 104°, matching how far the reference wall
   turns away at its ends. */
const COLS = 9;
const ROWS = 4;
const SPREAD = 13;
const PERSP = 34;      // cqw. Short, because the photograph is a wide-angle shot
const DEPTH = 35;      // cqw back from the eye
/* the chord one 13° step subtends at that depth, less a bezel's worth, so the
   panels meet edge to edge with daylight between them */
const PANEL = 7.9;

/* How far above the horizon the foot of the wall lands, in cqw.
 *
 * Nought would be the honest answer: the top step is at eye level, so a wall
 * standing on it has its foot exactly on the horizon whatever its distance.
 * But the statues and their labels are laid out by the page, not by the room,
 * and they sit lower than the photograph's floor — a wall whose foot lands
 * among them reads as a band ruled across the labels rather than as a wall
 * behind objects. So it is raised, as a wall on a low stage would be, until it
 * clears them; the perspective itself is untouched. */
const RISE = 3.3;

/* Scaling the panel, the depth and the perspective by one factor scales what
   is drawn by exactly that factor and nothing else — same curve, same
   foreshortening, same wall, smaller. Which is what a phone needs: the plate
   has to be nearly three times the viewport's width to cover it, so a wall
   that is a third of the plate runs off both edges of the screen. */
function wall(k: number, rise: number) {
  const panel = PANEL * k, depth = DEPTH * k, persp = PERSP * k;
  const scale = persp / (persp + depth);        // how far off the eye shrinks it
  const rowH = panel * (9 / 16) * 1.04;         // cqw between row centres
  return {
    panel: panel.toFixed(2),
    z: (-depth).toFixed(2),
    persp: persp.toFixed(2),
    /* the rows are centred on the anchor; drop them by half the wall so its
       foot lands on the horizon, then lift it by the rise */
    lift: (-ROWS / 2 - rise / (rowH * scale)).toFixed(3),
  };
}
const WIDE = wall(1, RISE);
const NARROW = wall(0.62, 2.5);

const stills = lectures
  .filter((l) => l.video.guide || l.video.lecture)
  .map((l) => `https://i.ytimg.com/vi/${l.video.guide ?? l.video.lecture}/mqdefault.jpg`);

type Clip = { id: string; webm: string; mp4: string };
const reel = (clips as Clip[]).map((c) => ({ webm: asset(c.webm), mp4: asset(c.mp4) }));

const screens = Array.from({ length: COLS * ROWS }, (_, i) => {
  const col = i % COLS;
  const row = Math.floor(i / COLS);
  return {
    deg: -((COLS - 1) / 2) * SPREAD + col * SPREAD,
    row: row - (ROWS - 1) / 2,
    a: stills[i % stills.length],
    b: stills[(i + 7) % stills.length],
    delay: ((i * 2.3) % 11).toFixed(1),
    clip: reel.length ? reel[i % reel.length] : null,
  };
});
---

<section class="bh" aria-labelledby="hall-title">
  <StyleSwitch lang={lang} current="bright" />
  <MotionToggle lang={lang} />

  <div class="bh__scene" aria-hidden="true">
    {/* the plate holds the photograph's own aspect ratio; everything inside is
        placed in per cent of it, so a crop moves picture and screens together */}
    <div class="bh__plate">
      <picture>
        <source srcset={asset('media/bright-hall.webp')} type="image/webp" />
        <img class="bh__photo" src={asset('media/bright-hall.jpg')} alt=""
             width={PLATE.w * 2} height={PLATE.h * 2} fetchpriority="high" decoding="async" />
      </picture>

      {/* the curved wall, standing on the top step */}
      {/* both sets of numbers are handed to the stylesheet, which picks one by
          width — an inline `--persp` could not be overridden by a media query */}
      <div class="bh__wallwrap"
           style={`--vp-x:${VP.x}%; --vp-y:${VP.y}%;
                   --persp-w:${WIDE.persp}cqw; --persp-n:${NARROW.persp}cqw`}>
        <div class="bh__wall"
             style={`--panel-w:${WIDE.panel}cqw; --z-w:${WIDE.z}cqw; --lift-w:${WIDE.lift};
                     --panel-n:${NARROW.panel}cqw; --z-n:${NARROW.z}cqw; --lift-n:${NARROW.lift}`}>
          {screens.map((s) => (
            <span class="bh__screen" style={`--deg:${s.deg}deg; --row:${s.row}; --delay:${s.delay}s`}>
              {s.clip ? (
                <video class="bh__vid" muted loop playsinline preload="none"
                       data-bh-clip={JSON.stringify(s.clip)} width="320" height="180"></video>
              ) : (
                <>
                  <img src={s.a} alt="" loading="lazy" decoding="async" width="320" height="180" />
                  <img class="b" src={s.b} alt="" loading="lazy" decoding="async" width="320" height="180" />
                </>
              )}
            </span>
          ))}
        </div>
        <span class="bh__glow"></span>
      </div>

    </div>

  </div>

  <div class="bh__masthead">
    <h1 id="hall-title" class="bh__title">{t('site.tagline')}</h1>
    <p class="bh__hint">{t('hall.hint')}</p>
  </div>

  <nav class="bh__plinths" aria-label={t('hall.enter')}>
    {cats.map((c) => (
      <a class="bh__piece" href={c.href} data-cat={c.key}>
        <span class="bh__art">
          <model-viewer
            class="bh__mv"
            src={c.model}
            alt={t('models.alt', { what: c.credit.title, cat: c.name })}
            poster={c.poster}
            loading="lazy"
            camera-orbit={CAMERA}
            field-of-view="30deg"
            interaction-prompt="none"
            disable-zoom
            environment-image="neutral"
            exposure="1.35"
            shadow-intensity="0.55"
            shadow-softness="0.9"
            auto-rotate
            auto-rotate-delay="0"
            rotation-per-second="14deg"
          >
            <img class="bh__poster" slot="poster" src={c.poster} alt="" width="512" height="512" />
          </model-viewer>
        </span>
        <span class="bh__plinth" aria-hidden="true"></span>
        <span class="bh__name">{c.name}</span>
          <span class="bh__name-en">{c.nameAlt}</span>
        <span class="bh__n">{c.n > 0 ? t('hall.count', { n: c.n }) : t('hall.soon')}</span>
      </a>
    ))}
  </nav>

  <a class="bh__intro" href={gallery(lang, INTRO)} data-cat={INTRO}>
    <span class="bh__intro-txt">
      <span class="bh__eyebrow">{t('hall.nobelRoom')}</span>
      <span class="bh__intro-title">{introA}<span class="conj">{introConj}</span>{introB}</span>
      <span class="bh__intro-desc">{t('hall.introDesc')}</span>
    </span>
    <span class="bh__cta" aria-hidden="true">{t('hall.introCta')} →</span>
  </a>
</section>

<style>
  .bh {
    position: relative;
    min-block-size: min(100svh, 62rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    padding-block: max(clamp(1.5rem, 4vh, 3.5rem), 4.4rem) clamp(2rem, 5vh, 4rem);
    overflow: hidden;
    isolation: isolate;
    /* flat, and exactly the colour the plate's own edges fade into — a
       gradient here reappears as a band under the photograph */
    background: var(--bg-0);
  }

  /* ---------- the room ---------- */
  .bh__scene { position: absolute; inset: 0; z-index: -1; overflow: hidden; }

  /* The plate is the photograph's own frame, and everything in the hall is
     positioned in per cent of it — so the wall keeps its place in the
     architecture whatever size the plate ends up.

     It is contained, not covering: the whole picture is in frame at every
     viewport and nothing is ever cropped away. The cost is that the plate no
     longer fills the hero, so it is pinned to the top and the page carries on
     beneath it — which is where the picture is emptiest floor anyway. */
  .bh__plate {
    container-type: inline-size;
    position: absolute;
    inset-inline-start: 50%; inset-block-start: 0;
    translate: -50% 0;
    aspect-ratio: 1672 / 871;
    inline-size: min(100%, calc(min(100svh, 62rem) * 1672 / 871));
    block-size: auto;
  }
  /* The only wash left, and it is a join rather than a veil: the foot of the
     picture into the page, and — on a screen wide enough that the plate cannot
     reach both edges — its sides. Without them the photograph ends on a ruled
     line, because its own edges are a warm grey and the page is white. */
  .bh__plate::after {
    content: '';
    position: absolute; inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, transparent 88%, var(--bg-0) 100%),
      linear-gradient(to right, var(--bg-0), transparent 3%,
                                transparent 97%, var(--bg-0));
  }
  .bh__photo {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%;
    object-fit: cover;
  }

  /* The anchor is the measured horizon, and because the wrapper is a point
     the perspective origin lands on it too — which is the whole trick. Every
     panel is then drawn from the same eye the photograph was taken with. */
  .bh__wallwrap {
    position: absolute;
    inset-inline-start: var(--vp-x);
    inset-block-start: var(--vp-y);
    perspective: var(--persp-w);
    transform: translate(-50%, -50%);
  }
  .bh__wall {
    position: relative; inline-size: 0; block-size: 0;
    transform-style: preserve-3d;
    --panel: var(--panel-w);
    --z: var(--z-w);
    --lift: var(--lift-w);
  }
  .bh__screen {
    position: absolute;
    /* sized against the plate, not the viewport, so the wall keeps its place
       in the architecture at every crop */
    inline-size: var(--panel);
    aspect-ratio: 16 / 9;
    margin-inline-start: calc(var(--panel) / -2);
    margin-block-start: calc(var(--panel) * -9 / 32);
    /* rotateY leaves the Y axis alone, so the lift is as true in the room as
       the rows are — the wall drops, it does not tilt */
    transform:
      rotateY(var(--deg))
      translateZ(var(--z))
      translateY(calc((var(--row) + var(--lift)) * 104%));
    background: #0d1013;
    border: 1px solid #14181c;
    border-radius: 1px;
    overflow: hidden;
    /* white marble behind a black screen wants a hard edge, not a glow */
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.62),
                0 1cqw 2cqw -0.6cqw rgba(52, 40, 24, 0.28);
  }
  .bh__screen img, .bh__vid {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%; object-fit: cover;
  }
  .bh__screen .b { opacity: 0; animation: bhswap 22s var(--delay) ease-in-out infinite; }
  @keyframes bhswap { 0%, 44% { opacity: 0 } 52%, 94% { opacity: 1 } 100% { opacity: 0 } }

  /* The light the screens throw back. On a dark plate this could be strong and
     blue; on white marble anything blue reads as a stain, so it is mostly the
     shadow the wall casts down onto the top step, with only a trace of screen
     light above it. Centred on the wall, which sits above the anchor. */
  .bh__glow {
    position: absolute; inset-inline-start: 50%; inset-block-start: -6cqw;
    inline-size: 62cqw; block-size: 30cqw;
    translate: -50% -50%;
    background:
      radial-gradient(52% 56% at 50% 44%, rgba(126, 158, 196, 0.16), transparent 74%),
      radial-gradient(46% 40% at 50% 96%, rgba(74, 58, 36, 0.20), transparent 76%);
    filter: blur(10px);
    pointer-events: none;
  }

  :global(html[data-motion='off']) .bh__screen .b { animation: none; }

  /* ---------- masthead ---------- */
  .bh__masthead { text-align: center; padding-inline: 1rem; position: relative; }
  .bh__title {
    font-family: var(--font-han-serif);
    font-size: var(--step-4);
    color: var(--cream);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.85);
  }
  .bh__hint {
    font-size: var(--step--1); color: var(--muted);
    margin: 0.5rem auto 0; max-inline-size: none;
    /* the wall can end up behind this line at narrow widths; the halo keeps it
       legible whatever it lands on */
    text-shadow: 0 0 6px #fff, 0 0 12px #fff;
  }

  /* ---------- the pieces ---------- */
  .bh__plinths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: clamp(0.6rem, 2vw, 1.4rem);
    align-items: end;
    inline-size: min(100% - 2rem, 80rem);
    margin: clamp(1.2rem, 3.5vh, 2.6rem) auto 0;
    position: relative;
  }
  .bh__piece {
    display: grid; justify-items: center; gap: 0.1rem;
    padding: 0.5rem 0.4rem 0.9rem;
    text-decoration: none;
    border-radius: var(--radius);
    transition: transform 0.4s var(--ease), background 0.3s var(--ease);
  }
  /* the piece lifts; no rectangle lights up behind it — see HallModels */
  .bh__piece:hover { transform: translateY(-4px); }
  .bh__piece:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  :global(html[data-motion='off']) .bh__piece:hover { transform: none; }

  .bh__art {
    inline-size: 100%; aspect-ratio: 1; max-inline-size: 11rem;
    display: grid; place-items: center; position: relative;
  }
  .bh__mv {
    inline-size: 100%; block-size: 100%;
    pointer-events: none;              /* the anchor owns every click */
    --poster-color: transparent;
    background: transparent;
    /* model-viewer draws a loading bar across the top of its own box, and it
       does not always clear itself once the model is in. Against a dark vault
       that never showed; on white marble it is a grey rule ruled across all six
       pieces. There is nothing for it to report anyway — the poster is already
       on screen while the model loads. */
    --progress-bar-height: 0px;
    --progress-bar-color: transparent;
  }
  .bh__poster { inline-size: 100%; block-size: 100%; object-fit: contain; }

  /* a marble pedestal, lit from the front */
  .bh__plinth {
    inline-size: min(72%, 8rem); block-size: 0.85rem;
    border-radius: 3px 3px 1px 1px;
    background: linear-gradient(to bottom, #ffffff, #e9e3d6 60%, #d8d0be);
    box-shadow: 0 6px 14px -6px rgba(60, 50, 34, 0.4);
  }
  /* the other language, set under the first — the halls name a prize the
     same way a lecture page names its laureate */
  .bh__name-en {
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-block-start: 0.1rem;
  }

  .bh__name {
    font-family: var(--font-han-serif);
    font-size: var(--step-0); color: var(--cream);
    margin-block-start: 0.55rem;
  }
  .bh__piece:hover .bh__name { color: var(--accent); }
  /* Two lines' worth whether it needs them or not. The pieces are bottom
     aligned, so one column whose count wraps — 'No lectures in this category
     yet' does, in English — lifts its whole column out of line with the other
     five. Same reason .bh__name-en holds two lines. */
  .bh__n {
    font-size: var(--step--1); color: var(--muted);
    min-block-size: 2lh;
  }

  /* ---------- introduction ---------- */
  .bh__intro {
    display: flex; align-items: center; gap: clamp(0.9rem, 2.5vw, 1.8rem);
    inline-size: min(100% - 2rem, 46rem);
    margin: clamp(1.4rem, 3.5vh, 2.4rem) auto 0;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(3px);
    text-decoration: none;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .bh__intro:hover { border-color: var(--accent); background: #fff; }
  .bh__intro-txt { display: grid; gap: 0.15rem; }
  .bh__eyebrow {
    font-size: var(--step--2); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent);
  }
  .bh__intro-title { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); }
  .bh__intro-title :global(.conj) { font-size: 0.72em; opacity: 0.7; margin-inline: 0.12em; }
  .bh__intro-desc { font-size: var(--step--1); color: var(--muted); }
  .bh__cta { margin-inline-start: auto; color: var(--accent); font-size: var(--step--1); white-space: nowrap; }

  @media (max-width: 48rem) {
    .bh__plinths { grid-template-columns: repeat(2, 1fr); }

    /* A 1.92:1 picture shown whole across a phone is a band, not a backdrop,
       so the scene is cut to exactly the height the picture needs and the page
       carries on below it. Nothing is cropped; there is simply less room. */
    .bh__scene { block-size: calc(100vw * 871 / 1672); }
    .bh__plate { inline-size: 100%; }
    /* clear of it, or the masthead sits astride the picture's lower edge */
    .bh { padding-block-start: calc(100vw * 871 / 1672 + 1.1rem); }
    /* The same wall at 0.62 — see the note by wall() for why the factor is
       enough on its own. Nothing else about the wall changes. */
    .bh__wallwrap { perspective: var(--persp-n); }
    .bh__wall { --panel: var(--panel-n); --z: var(--z-n); --lift: var(--lift-n); }
    .bh__intro { flex-wrap: wrap; }
    .bh__cta { margin-inline-start: 0; }
  }
  @media (max-width: 34rem) {
    /* the switch and the motion toggle stack at this width, so the picture
       alone is no longer the taller of the two */
    .bh { padding-block-start: max(8.7rem, calc(100vw * 871 / 1672 + 1.1rem)); }
  }
</style>

<script>
  import { motionOn } from '../scripts/motion';
  import '../../vendor/model-viewer.min.js';

  const viewers = [...document.querySelectorAll<HTMLElement>('.bh__mv')];
  function applyRotation() {
    for (const v of viewers) {
      if (motionOn()) v.setAttribute('auto-rotate', '');
      else v.removeAttribute('auto-rotate');
    }
  }
  applyRotation();
  addEventListener('motionpref', applyRotation);

  /* Only the middle of the wall gets a decoder if clips ever land — thirty-six
     simultaneous videos is not a backdrop, it is a stress test. */
  const screens = [...document.querySelectorAll<HTMLVideoElement>('.bh__vid')];
  if (screens.length && motionOn()) {
    const mid = screens.length / 2;
    screens.forEach((v, i) => {
      if (Math.abs(i - mid) > 4) return;
      const c = JSON.parse(v.dataset.bhClip ?? 'null');
      if (!c) return;
      const webm = document.createElement('source');
      webm.src = c.webm; webm.type = 'video/webm';
      const mp4 = document.createElement('source');
      mp4.src = c.mp4; mp4.type = 'video/mp4';
      v.append(webm, mp4);
      v.load();
      v.play().catch(() => {});
    });
  }
</script>
