---
/**
 * VideoFacade.astro — a YouTube embed that costs nothing until it is clicked.
 *
 * Idle    : one lazy poster image (~12 KB).
 * Hover   : three real frames from across the video (1/2/3.jpg, ~3.5 KB each)
 *           crossfade as a short cine-loop — the 極短視頻演示 hint, using
 *           YouTube's own always-available thumbnails. Loaded on demand only.
 * Click   : swaps in a youtube-nocookie iframe and plays.
 *
 * Nothing is downloaded, re-hosted or proxied; playback is always YouTube's.
 */
interface Props {
  id: string;                 // YouTube video id
  title: string;              // accessible label — what will play
  kind?: 'guide' | 'lecture' | 'interview' | 'plain';
  label?: string;             // small caption over the frame
  note?: string;
  playHint: string;
  eager?: boolean;
}
const { id, title, kind = 'plain', label, note, playHint, eager = false } = Astro.props;
const poster = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const posterHi = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
---

<figure class="vf" data-kind={kind}>
  {note && <figcaption class="vf__note">{note}</figcaption>}
  <button
    class="vf__btn"
    type="button"
    data-yt={id}
    aria-label={`${playHint} — ${title}`}
  >
    <img
      class="vf__poster"
      src={poster}
      srcset={`${poster} 480w, ${posterHi} 1280w`}
      sizes="(max-width: 48rem) 100vw, 46rem"
      alt=""
      width="1280"
      height="720"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="vf__frames" aria-hidden="true"></span>
    <span class="vf__scrim"></span>
    <span class="vf__play" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="62" height="44">
        <path class="vf__play-bg" d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2 0 34 0 34 0S12.8 0 7.5 1.7a8.5 8.5 0 0 0-6 6A89 89 0 0 0 0 24a89 89 0 0 0 1.5 16.3 8.5 8.5 0 0 0 6 6C12.8 48 34 48 34 48s21.2 0 26.5-1.7a8.5 8.5 0 0 0 6-6A89 89 0 0 0 68 24a89 89 0 0 0-1.5-16.3z"/>
        <path d="M27 34V14l18 10z" fill="#fff"/>
      </svg>
    </span>
    {label && <span class="vf__label">{label}</span>}
  </button>
</figure>

<style>
  .vf { margin: 0; }

  .vf__btn {
    position: relative;
    display: block;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    cursor: pointer;
    overflow: hidden;
    touch-action: manipulation;      /* no double-tap-zoom delay before the click */
    -webkit-tap-highlight-color: transparent;
    transition: border-color 0.35s var(--ease), transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .vf__btn:focus-visible {
    border-color: var(--line-hi);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }
  /* hover only where a pointer can actually hover */
  @media (hover: hover) and (pointer: fine) {
    .vf__btn:hover {
      border-color: var(--line-hi);
      transform: translateY(-2px);
      box-shadow: var(--shadow-lift);
    }
    .vf__btn:hover .vf__play { scale: 1.09; }
    .vf__btn:hover .vf__play-bg { fill: #cc2027; fill-opacity: 1; }
  }

  .vf__poster,
  .vf__frames {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .vf__poster { transition: opacity 0.5s var(--ease), transform 6s linear; }

  /* the three sampled frames live here, stacked and crossfading */
  .vf__frames { opacity: 0; transition: opacity 0.45s var(--ease); }
  .vf__frames :global(img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    opacity: 0;
    animation: vf-cine 4.5s steps(1, end) infinite;
  }
  .vf__frames :global(img:nth-child(1)) { animation-delay: 0s; }
  .vf__frames :global(img:nth-child(2)) { animation-delay: 1.5s; }
  .vf__frames :global(img:nth-child(3)) { animation-delay: 3s; }
  @keyframes vf-cine {
    0%, 33.32% { opacity: 1; }
    33.33%, 100% { opacity: 0; }
  }

  .vf__btn[data-cine='on'] .vf__frames { opacity: 1; }
  .vf__btn[data-cine='on'] .vf__poster { transform: scale(1.04); }

  .vf__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 60% at 50% 45%, transparent 30%, rgba(18, 12, 6, 0.35) 100%),
      linear-gradient(to top, rgba(18, 12, 6, 0.72), transparent 55%);
    pointer-events: none;
  }

  .vf__play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    translate: -50% -50%;
    transition: scale 0.35s var(--ease);
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.6));
  }
  .vf__play-bg { fill: #16100a; fill-opacity: 0.82; transition: fill 0.3s var(--ease), fill-opacity 0.3s var(--ease); }
  .vf__btn:focus-visible .vf__play { scale: 1.09; }

  /* same badge as LectureCard's — top-left, category block colour, dark text.
     If you restyle one, restyle the other. */
  /* immediate acknowledgement: the player takes a moment to appear */
  .vf__btn[data-loading] .vf__poster { filter: brightness(0.45); }
  .vf__btn[data-loading] .vf__play { animation: vf-pulse 0.9s ease-in-out infinite; }
  @keyframes vf-pulse { 50% { scale: 0.86; opacity: 0.55; } }

  .vf__label {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-start: 0.6rem;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    color: #150d05;
    background: var(--accent-block);
    border-radius: 2px;
    padding: 0.16rem 0.5rem;
  }

  /* the note leads the frame: it is the line that decides whether someone presses play */
  .vf__note {
    margin-block-end: 0.5rem;
    font-size: var(--step--1);
    color: var(--text);
  }

  /* the player, built on pointerdown and hidden until the tap completes */
  .vf :global(.vf__frame.is-waiting) {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .vf { position: relative; }

  /* live iframe */
  .vf :global(iframe) {
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line-hi);
    border-radius: var(--radius);
    display: block;
  }

  :global(html[data-motion='off']) .vf__frames { display: none; }
  :global(html[data-motion='off']) .vf__btn[data-cine='on'] .vf__poster { transform: none; }
</style>

<script>
  /*
   * One delegated handler for every facade on the page.
   *
   * Getting playback to start on the FIRST tap is the whole difficulty here.
   * Mobile browsers refuse to start unmuted video in an iframe that was
   * created after the gesture, so a player built inside the click handler
   * arrives paused and needs a second tap on YouTube's own button.
   *
   * So the player is built on pointerdown — before the gesture finishes —
   * hidden behind the poster. The click that follows then lands on a player
   * that already exists, and the play command goes out inside a real user
   * gesture. If the finger turns out to be scrolling rather than tapping, the
   * half-built player is thrown away again.
   */
  const CINE = 'data-cine';
  const ORIGIN = 'https://www.youtube-nocookie.com';
  const MOVE_CANCEL = 12;               // px of travel that means "scroll", not "tap"

  type Pending = { btn: HTMLElement; frame: HTMLIFrameElement; x: number; y: number };
  let pending: Pending | null = null;

  function addFrames(btn: HTMLElement) {
    if (btn.dataset.framesLoaded) return;
    btn.dataset.framesLoaded = '1';
    const id = btn.dataset.yt;
    const host = btn.querySelector('.vf__frames');
    if (!id || !host) return;
    for (const n of [1, 2, 3]) {
      const img = document.createElement('img');
      img.src = `https://i.ytimg.com/vi/${id}/${n}.jpg`;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      host.appendChild(img);
    }
  }

  function buildFrame(btn: HTMLElement): HTMLIFrameElement | null {
    const id = btn.dataset.yt;
    if (!id) return null;
    const f = document.createElement('iframe');
    f.src =
      `${ORIGIN}/embed/${id}` +
      `?autoplay=1&rel=0&modestbranding=1&playsinline=1&cc_load_policy=1&enablejsapi=1`;
    f.title = btn.getAttribute('aria-label') ?? 'YouTube';
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    f.allowFullscreen = true;
    f.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
    return f;
  }

  /** ask the player to start, repeatedly, until it says it has */
  function urge(frame: HTMLIFrameElement) {
    const send = (func: string) =>
      frame.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args: [] }), ORIGIN);
    let tries = 0;
    const timer = window.setInterval(() => {
      if (++tries > 8) return window.clearInterval(timer);
      frame.contentWindow?.postMessage(JSON.stringify({ event: 'listening' }), ORIGIN);
      send('playVideo');
    }, 300);
    const onMsg = (e: MessageEvent) => {
      if (e.origin !== ORIGIN || e.source !== frame.contentWindow) return;
      try {
        const d = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
        if (d?.event === 'onStateChange' && d.info === 1) {
          window.clearInterval(timer);
          removeEventListener('message', onMsg);
        }
      } catch { /* not ours */ }
    };
    addEventListener('message', onMsg);
    send('playVideo');
  }

  /** build the player now, keeping the poster in front of it */
  function prepare(btn: HTMLElement, x: number, y: number) {
    if (pending || btn.hasAttribute('data-live')) return;
    const fig = btn.closest('.vf');
    const frame = buildFrame(btn);
    if (!fig || !frame) return;
    frame.classList.add('vf__frame', 'is-waiting');
    fig.appendChild(frame);
    btn.setAttribute('data-loading', '');
    pending = { btn, frame, x, y };
  }

  function discard() {
    if (!pending) return;
    pending.frame.remove();
    pending.btn.removeAttribute('data-loading');
    pending = null;
  }

  /** the gesture completed on the facade: reveal the player and start it */
  function reveal(btn: HTMLElement) {
    let frame = pending && pending.btn === btn ? pending.frame : null;
    if (!frame) {                       // keyboard, or a browser with no pointerdown
      frame = buildFrame(btn);
      if (!frame) return;
      frame.classList.add('vf__frame');
      btn.closest('.vf')?.appendChild(frame);
    }
    pending = null;
    frame.classList.remove('is-waiting');
    btn.setAttribute('data-live', '');
    btn.remove();
    urge(frame);
    frame.focus();
  }

  addEventListener('pointerdown', (e) => {
    const btn = (e.target as Element)?.closest?.('.vf__btn') as HTMLElement | null;
    if (!btn || (e as PointerEvent).button !== 0) return;
    prepare(btn, (e as PointerEvent).clientX, (e as PointerEvent).clientY);
  }, { passive: true });

  addEventListener('pointermove', (e) => {
    if (!pending) return;
    const ev = e as PointerEvent;
    if (Math.hypot(ev.clientX - pending.x, ev.clientY - pending.y) > MOVE_CANCEL) discard();
  }, { passive: true });

  addEventListener('pointercancel', discard, { passive: true });
  addEventListener('scroll', () => { if (pending) discard(); }, { passive: true });

  addEventListener('click', (e) => {
    const btn = (e.target as Element)?.closest?.('.vf__btn') as HTMLElement | null;
    if (btn) { e.preventDefault(); reveal(btn); }
  });

  // The cine preview belongs to a hovering mouse. On touch, pointerenter fires
  // as part of the tap, and reacting to it changes the page before the click —
  // which is what makes a browser swallow the first tap.
  addEventListener('pointerenter', (e) => {
    if ((e as PointerEvent).pointerType !== 'mouse') return;
    const btn = (e.target as Element)?.closest?.('.vf__btn') as HTMLElement | null;
    if (!btn) return;
    addFrames(btn);
    btn.setAttribute(CINE, 'on');
  }, true);

  addEventListener('focusin', (e) => {
    const btn = (e.target as Element)?.closest?.('.vf__btn') as HTMLElement | null;
    if (!btn) return;
    addFrames(btn);
    btn.setAttribute(CINE, 'on');
  }, true);

  for (const ev of ['pointerleave', 'focusout'] as const) {
    addEventListener(ev, (e) => {
      if (ev === 'pointerleave' && (e as PointerEvent).pointerType !== 'mouse') return;
      const btn = (e.target as Element)?.closest?.('.vf__btn') as HTMLElement | null;
      if (btn) btn.removeAttribute(CINE);
    }, true);
  }
</script>
