---
/**
 * ExtLink.astro — the only way this site links off-site.
 *
 * Always opens in a new tab, always carries rel="noopener noreferrer", and
 * always tells assistive tech that it will. Use it for every external href so
 * the behaviour cannot drift between components.
 */
import { useT, type Lang } from '../i18n/ui';

interface Props {
  href: string;
  lang: Lang;
  class?: string;
  arrow?: boolean;   // show the ↗ affordance
}
const { href, lang, class: cls, arrow = true } = Astro.props;
const t = useT(lang);
/* Every off-site link in the museum comes through here, so this is where the
   spec's rule about them lives: an external reference is a nav-weight button,
   never a primary one. Doing it here rather than at each call site is the
   same argument as the rel and the target — the behaviour cannot drift
   between components if there is only one component. */
const klass = ['museum-glass-btn', 'museum-glass-btn--nav', cls].filter(Boolean).join(' ');
---
<a href={href} class={klass} target="_blank" rel="noopener noreferrer">
  {/* The label is wrapped, not passed through bare. The button kit paints its
      glass on a positioned ::before, and a bare text node has no z-index of
      its own to be lifted by the kit's `.museum-glass-btn > * { z-index: 1 }`
      — so the glass paints over the words and the label goes pale. Every
      example in the kit's own START-HERE wraps the label; this is that. */}
  <span><slot /></span>
  {arrow && <span class="ext-arrow" aria-hidden="true">↗</span>}
  <span class="visually-hidden">{t('a11y.newTab')}</span>
</a>

<style>
  .ext-arrow { font-size: 0.85em; opacity: 0.7; margin-inline-start: 0.35em; }
</style>
