---
import Base from '../layouts/Base.astro';
import { useT, type Lang } from '../i18n/ui';
import ExtLink from './ExtLink.astro';
import { specialEvents, hosts } from '../data/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const special = specialEvents;
const hostList = Object.entries(hosts);
---

<Base lang={lang} title={t('about.title')} segments={['about']}>
  <div class="wrap-narrow about">
    <h1>{t('about.title')}</h1>

    {lang === 'zh' ? (
      <div class="prose stack" style="--gap:1.2rem">
        <p class="lede">
          「臺灣橋樑計畫」（Taiwan Bridges Program）由國立臺灣大學與中央研究院聯合推動，賴清德總統擔任榮譽主席，
          在李遠哲院士倡議與光寶科技創辦人宋恭源先生支持下，結合國內 12 個學研機構，
          並與世界和平基金會（International Peace Foundation, IPF）合作，
          於 2025 至 2026 年邀請 31 位諾貝爾獎得主來臺演講與交流。
        </p>
        <p>
          臺大以「宋恭源先生頂尖研究講座」（NTU Raymond Soong Chair Professorship of Distinguished Research）名義辦理其中 6 場。這些演講、導讀影片與專訪原本分散於不同頻道與機構網頁，本站將其收攏為一座線上博物館，
          供高中生、大學生與一般大眾瀏覽。
        </p>
        <h2>影片與版權</h2>
        <p>
          本站不儲存、不轉錄、不重製任何影片。所有影片皆以 YouTube 內嵌方式播放，
          版權屬於原始發布單位，主要為世界和平基金會（International Peace Foundation）頻道與臺大演講網（NTU Speech）。
          諾貝爾基金會（Nobel Foundation）的文字與圖像一律以連結方式引用，不複製到本站。
        </p>
        <p>
          「諾貝爾獎」（Nobel Prize）名稱與獎章為諾貝爾基金會（Nobel Foundation）之商標。本站為教育用途之獨立專案，
          與諾貝爾基金會無隸屬關係，亦未獲其背書。
        </p>
        <h2>隱私</h2>
        <p>
          本站沒有帳號、沒有追蹤 Cookie、沒有第三方廣告。影片使用 YouTube 的
          <code>youtube-nocookie.com</code> 網域，在按下播放之前，不會載入 YouTube 的任何程式碼。
        </p>
      </div>
    ) : (
      <div class="prose stack" style="--gap:1.2rem">
        <p class="lede">
          The Taiwan Bridges Program is run jointly by National Taiwan University and Academia Sinica,
          with President Ching-te Lai as honorary chair, initiated by Academician Yuan-Tseh Lee and
          supported by Raymond Soong, founder of Lite-On Technology. Across 12 Taiwanese research and
          teaching institutions and in partnership with the International Peace Foundation, it brought
          31 Nobel laureates to Taiwan to lecture between 2025 and 2026.
        </p>
        <p>
          Six of those lectures were hosted by NTU under the Raymond Soong Chair Professorship of
          Distinguished Research. The lectures, guide videos and interviews were scattered across several channels and
          institutional pages. This site gathers them into one place.
        </p>
        <h2>Video and rights</h2>
        <p>
          Nothing here is stored, downloaded, re-cut or re-hosted. Every video is embedded from
          YouTube and remains the copyright of its original publisher, chiefly the International
          Peace Foundation channel and 臺大演講網. Nobel Foundation text and images are linked, never
          copied.
        </p>
        <p>
          "Nobel Prize" and the medal are trademarks of the Nobel Foundation. This is an independent
          educational project, not affiliated with or endorsed by the Nobel Foundation.
        </p>
        <h2>Privacy</h2>
        <p>
          No accounts, no tracking cookies, no third-party advertising. Embeds use YouTube's
          <code>youtube-nocookie.com</code> domain, and no YouTube code loads until playback begins.
        </p>
      </div>
    )}

    <h2>{t('special.title')}</h2>
    <ul class="special" role="list">
      {special.map((s) => (
        <li>
          <ExtLink lang={lang} href={`https://www.youtube.com/watch?v=${s.yt}`}>
            {lang === 'zh' ? s.title_zh : s.title_en}
          </ExtLink>
          <span>{s.date}{s.note_zh && lang === 'zh' ? ` · ${s.note_zh}` : ''}</span>
        </li>
      ))}
    </ul>

    <h2>{lang === 'zh' ? '主辦與協辦單位' : 'Host institutions'}</h2>
    <ul class="hosts" role="list">
      {hostList.map(([, h]) => <li>{lang === 'zh' ? h.zh : h.en}</li>)}
    </ul>
  </div>
</Base>

<style>
  .about { padding-block: clamp(2rem, 5vw, 3.5rem) 0; }
  .about h1 { font-size: var(--step-3); color: var(--cream); margin-block-end: 1.5rem; }
  .about h2 {
    font-size: var(--step-1); color: var(--cream);
    margin-block: 2.5rem 0.9rem; padding-block-start: 1.5rem; border-block-start: 1px solid var(--line);
  }
  .prose p { color: var(--text); line-height: 1.9; }
  .lede { font-size: var(--step-1); color: var(--cream); }
  code { font-size: 0.88em; background: var(--surface-hi); padding: 0.1em 0.4em; border-radius: 2px; }

  .special { display: grid; gap: 0.9rem; padding: 0; margin: 0; }
  .special li { display: grid; gap: 0.1rem; }
  .special a { justify-self: start; }
  .special span { font-size: var(--step--1); color: var(--muted-dim); }

  .hosts { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0; }
  .hosts li {
    font-size: var(--step--1); color: var(--muted);
    border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.8rem;
  }
</style>
