---
import Base from '../layouts/Base.astro';
import LectureCard from './LectureCard.astro';
import Sculpture from './Sculpture.astro';
import { useT, type Lang } from '../i18n/ui';
import { home, asset } from '../i18n/routing';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import {
  byCategory, catName, categories, factsAsOf, intro, introParts, INTRO,
  type GalleryKey, type CategoryKey,
} from '../data/catalog';

interface Props { lang: Lang; cat: GalleryKey }
const { lang, cat } = Astro.props;
const t = useT(lang);

import { catNameAlt } from '../data/catalog';
const title = catName(cat, lang);
/** the same prize in the other language, set under the heading */
const titleAlt = catNameAlt(cat, lang);
const recs = byCategory(cat);

/** the introduction room holds the story of the prize, not lectures */
const isIntro = cat === INTRO;
const meta = isIntro ? null : categories[cat as CategoryKey];
/** a real prize category that this lecture series never covered */
const isEmpty = !isIntro && recs.length === 0;
const [introA, introConj, introB] = introParts(lang);

const INTRO_LINKS = [
  { url: 'https://www.nobelprize.org/alfred-nobel/',
    zh: '諾貝爾其人', en: 'Alfred Nobel, the man',
    dzh: '炸藥的發明者，與他留下的遺囑。', den: 'The inventor of dynamite, and the will he left behind.' },
  { url: 'https://www.nobelprize.org/prizes/facts/nobel-prize-facts/',
    zh: '諾貝爾獎小知識', en: 'Nobel Prize facts',
    dzh: '最年輕、最年長、得過 2 次的人：官方統計。', den: 'Youngest, oldest, twice-awarded: the official numbers.' },
  { url: 'https://www.nobelprize.org/the-nobel-prize-organisation/',
    zh: '獎項如何評選', en: 'How the prizes are decided',
    dzh: '提名、審議、保密 50 年的評選過程。', den: 'Nomination, deliberation, and 50 years of secrecy.' },
  { url: 'https://www.nobelprize.org/educational/',
    zh: '諾貝爾教育資源', en: 'Nobel Prize education',
    dzh: '官方為學生製作的互動教材與遊戲（英文）。', den: 'Interactive teaching material and games from the official site.' },
];
const links = isIntro ? INTRO_LINKS : meta!.links;

/* ---------------------------------------------------------------
 * The bright museum shows the prize's own sculpture here, standing on the
 * same drum and lit by the same room as in the hall — a prize page is a room
 * in the museum, not a document about one. The dark site keeps its line
 * drawing.
 *
 * Fingerprinted for the same reason the hall does it: anything under public/
 * keeps its URL for ever, so a redeployed model sits behind whatever the
 * visitor already cached.
 * ------------------------------------------------------------- */
const bright = process.env.THEME === 'bright';
const stamp = (rel: string) => {
  const hash = createHash('sha256')
    .update(readFileSync(new URL(`../../public/${rel}`, import.meta.url)))
    .digest('hex').slice(0, 8);
  return `${asset(rel)}?v=${hash}`;
};
const piece = bright && !isIntro ? {
  model: stamp(`assets/models/gold/${cat}.glb`),
  poster: stamp(`assets/models/gold/${cat}.webp`),
  mark: stamp(`assets/marks/${cat}.webp`),
} : null;
/* the hall's own camera, so the piece is the same object at the same angle */
const CAMERA = '35deg 98deg 1.55m';
const CAMERA_LIMIT = 'auto auto 1.55m';
---

{/* The bright museum's prize pages carry the hall's own bar: no white band
    above the room, and the way back is a key in the corner rather than a line
    of text under the title. */}
<Base lang={lang} title={title} segments={['gallery', cat]} bare={bright}>
  {bright ? (
    <>
    <header class="gr" data-cat={cat}>
      {/* the hall's own room, and no band of empty page above it */}
      <div class="gr__room" aria-hidden="true">
        <picture>
          <source srcset={asset('media/bright-hall.webp')} type="image/webp" />
          <img src={asset('media/bright-hall.jpg')} alt="" width="1672" height="941"
               fetchpriority="high" decoding="async" />
        </picture>
      </div>

      {/* the museum's name, in the mark it folds into on the hall — and it is
          the way back, which is why the 'return to the hall' line under the
          title has gone: two doors out of one room, side by side, is one too
          many */}
      <a class="gr__lock" href={home(lang)} aria-label={t('nav.backHall')}>
        <span class="gr__lock-name">{t('site.tagline')}</span>
      </a>

      <div class="wrap gr__in">
        <div class="gr__id">
          <h1 class="gr__title">
            {isIntro ? <>{introA}<span class="conj">{introConj}</span>{introB}</> : title}
          </h1>
          {!isIntro && <p class="gr__title-en">{titleAlt}</p>}
          <p class="gr__n">
            {isIntro ? t('hall.nobelRoom') : recs.length > 0 ? t('hall.count', { n: recs.length }) : t('hall.soon')}
          </p>
        </div>
      </div>

      <a class="bh__cue gr__cue" href="#gr-body" aria-label={t('hall.scroll')}>
        <span class="bh__cue-rule" aria-hidden="true"><i></i></span>
        <svg class="bh__cue-chev" viewBox="0 0 26 9" aria-hidden="true" focusable="false">
          <path d="M1.6 1.6 L13 7.4 L24.4 1.6" />
        </svg>
        <span class="bh__cue-txt" aria-hidden="true">{t('hall.scroll')}</span>
      </a>
    </header>

    {/* The piece rides up with the page and then stops.
        It is a sticky rail rather than a scripted position: sticky is the
        compositor's own job, so the piece cannot lag a frame behind the page
        the way a scroll-driven transform does — that lag is exactly what made
        the hall's row shiver before it was pinned. The rail carries no height
        of its own and is pulled back up over the room by the piece's own
        height, so the piece stands on the floor of the photograph until the
        museum's name catches it. */}
    {piece && (
      <div class="gr__rail" aria-hidden="true">
        <div class="gr__piece">
          <span class="bh__art">
            <model-viewer
              class="bh__mv"
              src={piece.model}
              alt={t('models.alt', { what: title, cat: title })}
              poster={piece.poster}
              camera-orbit={CAMERA}
              camera-target="0m 0m 0m"
              min-camera-orbit={CAMERA_LIMIT}
              max-camera-orbit={CAMERA_LIMIT}
              field-of-view="30deg"
              interaction-prompt="none"
              disable-zoom
              environment-image="neutral"
              exposure="1.35"
              shadow-intensity="0.55"
              shadow-softness="0.9"
              autoplay
            >
              <img class="bh__poster" slot="poster" src={piece.poster} alt="" width="640" height="1280" />
            </model-viewer>
            <span class="bh__face" aria-hidden="true">
              <img class="bh__mark" src={piece.mark} alt="" width="192" height="192" decoding="async" />
              <span class="bh__name">{title}</span>
              <span class="bh__name-en">{titleAlt}</span>
            </span>
          </span>
        </div>
      </div>
    )}
    </>
  ) : (
    <header class="gh" data-cat={cat}>
      <div class="wrap gh__in">
        <div class="gh__art" aria-hidden="true"><Sculpture cat={cat} size={150} id={`gal-${cat}`} /></div>
        <div class="gh__id">
          <p class="eyebrow"><a class="gh__back" href={home(lang)}>← {t('cat.back')}</a></p>
          <h1 class="gh__title">
            {isIntro ? <>{introA}<span class="conj">{introConj}</span>{introB}</> : title}
          </h1>
          {!isIntro && <p class="gh__title-en">{titleAlt}</p>}
          <p class="gh__n">
            {isIntro ? t('hall.nobelRoom') : recs.length > 0 ? t('hall.count', { n: recs.length }) : t('hall.soon')}
          </p>
        </div>
      </div>
    </header>
  )}
  <span id="gr-body" class="gr__anchor"></span>

  {meta && (
    <section class="about" data-cat={cat} aria-labelledby="h-about">
      <div class="wrap about__in">
        <div class="about__prose">
          <h2 id="h-about" class="visually-hidden">{t('cat.aboutPrize')}</h2>
          <p class="about__lede">{meta.intro[lang]}</p>
          <p class="about__hist">{meta.history[lang]}</p>
        </div>
        <div class="about__figures">
          <dl class="stats">
            {meta.stats.map((s) => (
              <div class="stats__item">
                <dt>{lang === 'zh' ? s.zh : s.en}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
          <p class="asof">{t('cat.asOf', { date: factsAsOf })}</p>
        </div>
      </div>

      <div class="wrap">
        <nav class="mats" aria-label={t('cat.materials')}>
          <ul class="mats__list" role="list">
            {links.map((l, i) => (
              <li class="mat">
                <a class="mat__link museum-glass-btn museum-glass-btn--nav" href={l.url} target="_blank" rel="noopener noreferrer"
                   aria-describedby={`tip-${i}`}>
                  {lang === 'zh' ? l.zh : l.en}
                  <span class="mat__ext" aria-hidden="true">↗</span>
                  <span class="visually-hidden">{t('a11y.newTab')}</span>
                </a>
                <span class="mat__tip" id={`tip-${i}`} role="tooltip">
                  <span class="mat__tip-d">{lang === 'zh' ? l.dzh : l.den}</span>
                  <span class="mat__tip-h">{new URL(l.url).hostname.replace(/^www\./, '')}</span>
                </span>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>
  )}

  <div class="wrap gh__body" data-cat={cat}>
    {!isIntro && (
      <section aria-labelledby="h-lectures">
        <h2 id="h-lectures" class="sec-h">{t('cat.lectures')}</h2>
        {isEmpty ? (
          <div class="empty">
            <h3 class="empty__t">{t('cat.emptyTitle')}</h3>
            <p class="empty__b">{t('cat.emptyBody')}</p>
          </div>
        ) : (
          <ul class="grid" role="list">
            {recs.map((rec) => <li><LectureCard lang={lang} rec={rec} /></li>)}
          </ul>
        )}
      </section>
    )}

    {isIntro && (
      <section class="materials" aria-label={intro[lang]}>
        <ul class="cards" role="list">
          {links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer">
                <span class="cards__t">{lang === 'zh' ? l.zh : l.en}</span>
                <span class="cards__d">{lang === 'zh' ? l.dzh : l.den}</span>
                <span class="cards__host">{new URL(l.url).hostname.replace(/^www\./, '')} ↗</span>
                <span class="visually-hidden">{t('a11y.newTab')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  /* ---------- the prize's own room (bright museum) ----------
   *
   * A prize page opens the way the hall does: the same photograph, the same
   * piece on the same drum, the museum's name in the corner and the way on at
   * the foot. What it does not do is hold still — this room scrolls away, and
   * the lectures are the page.
   *
   * The photograph is cropped here where the hall shows it whole. The hall is
   * the room; this is a view into it, and a view can be framed. It is cropped
   * from the top, keeping the floor and the colonnade, because the floor is
   * what the piece has to stand on.
   */
  .gr {
    position: relative;
    isolation: isolate;
    block-size: clamp(21rem, 60svh, 32rem);
    display: grid;
    align-items: end;
    overflow: hidden;
  }
  .gr__room { position: absolute; inset: 0; z-index: -1; }
  .gr__room img {
    inline-size: 100%; block-size: 100%;
    object-fit: cover;
    object-position: 50% 74%;
  }
  /* the picture's own edges are a warm grey and the page is white; without
     this it ends on a ruled line */
  .gr__room::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 78%, var(--bg-0) 100%);
  }

  /* the mark the hall's name folds into, in the same gold glass — see
     'the name, condensed' in bright.css, which this borrows outright */
  /* Fixed, not absolute. It is the museum's name: it does not belong to the
     top of this room, it belongs to the whole of it, and it has to be there
     when the piece arrives beside it. */
  .gr__lock {
    position: fixed;
    inset-block-start: 0.62rem;
    inset-inline-start: clamp(0.7rem, 2.2vw, 1.6rem);
    z-index: 2;
    padding: 0.34rem 0.85rem;
    border-radius: 0.42rem;
    text-decoration: none;
    background: var(--glass-g-bg);
    backdrop-filter: blur(6px) saturate(1.5);
    box-shadow: var(--glass-g-edge);
    transition: filter 0.28s var(--ease), transform 0.28s var(--ease);
  }
  .gr__lock:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .gr__lock .gr__lock-name { color: #2b2008; }
  .gr__lock-name {
    font-family: var(--font-han-serif);
    font-size: var(--step-0);
    letter-spacing: 0.07em;
    text-indent: 0.07em;
    color: var(--cream);
  }

  .gr__in {
    display: flex;
    align-items: flex-end;
    /* the piece stands to the left of this on its own rail, so the words are
       set in from it */
    justify-content: flex-start;
    padding-inline-start: calc(var(--gr-art) / 2 + clamp(0.8rem, 3vw, 2.6rem));
    gap: clamp(0.8rem, 3vw, 2.6rem);
    /* the floor of the crop, measured on the rendered page: below this the
       picture is fading into the page and there is nothing to stand on */
    padding-block-end: clamp(1.2rem, 3.4vh, 2.2rem);
  }
  /* The rail: no height, pulled back up over the room by exactly the piece's
     own height plus the floor's clearance, so the piece starts standing on the
     photograph's floor. Sticky from there, for the whole document. */
  .gr__rail {
    position: sticky;
    inset-block-start: var(--gr-stick);
    z-index: 3;
    /* A hair of height, and the pull-up given straight back underneath.
       The rail has to sit its own height higher than where the flow would put
       it, and must not take that height from anything else — a bare negative
       top margin moved the page up with it and slid the first paragraph under
       the room. One pixel because a box of exactly zero height collapses its
       own two margins together and lands back where it started. */
    block-size: 1px;
    margin-block-start: calc(-1 * (var(--gr-art) + var(--gr-floor)));
    margin-block-end: calc(var(--gr-art) + var(--gr-floor) - 1px);
    pointer-events: none;
  }
  .gr__piece {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: max(1rem, calc((100vw - 76rem) / 2));
    transform-origin: 0 0;
    transition: scale 0.45s var(--ease), translate 0.45s var(--ease);
  }
  /* Caught. Full size it would stand over the lectures for the rest of the
     page, so at the moment the name catches it the piece becomes a mark of
     itself and takes its place in the row of keys. */
  .gr__rail[data-pinned] .gr__piece {
    scale: 0.2;
    translate: clamp(5.4rem, 7vw, 6.6rem) -0.4rem;
  }
  :global(html[data-motion='off']) .gr__piece { transition: none; }
  .gr__piece .bh__art {
    /* the cage's ratio, not a half — the same figure the hall frames by, so
       one piece is not two sizes in two rooms */
    inline-size: calc(var(--gr-art) * 0.545);
    block-size: var(--gr-art);
    aspect-ratio: auto;
    max-inline-size: none;
  }
  /* On both, because the rail is the header's *sibling* — it has to be, to
     stick for the whole document rather than for the height of the room. A
     var set on .gr alone does not reach it, and every fallback in the rail's
     own arithmetic quietly took over: the piece parked 50px too low and its
     rest position was measured against a height it does not have. */
  .gr, .gr__rail {
    --gr-art: clamp(13rem, 38svh, 21rem);
    --gr-floor: clamp(1.2rem, 3.4vh, 2.2rem);
    --gr-stick: 0.45rem;
  }
  .gr__id { padding-block-end: 0.2rem; }
  .gr__title {
    font-family: var(--font-han-serif);
    font-size: var(--step-3);
    color: var(--cream);
    letter-spacing: 0.04em;
    text-shadow: 0 0 3px rgba(255, 255, 255, 0.95), 0 0 12px rgba(255, 255, 255, 0.8);
  }
  .gr__title .conj { font-size: 0.55em; opacity: 0.68; margin-inline: 0.2em; vertical-align: 0.1em; }
  .gr__title-en {
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    color: var(--muted);
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
  }
  .gr__n {
    font-size: var(--step--1); color: var(--accent); letter-spacing: 0.14em;
    margin-block-start: 0.3rem;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
  }
  .gr__cue {
    position: absolute;
    inset-block-end: 0.5rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    z-index: 2;
  }
  .gr__anchor { display: block; scroll-margin-block-start: 4rem; }

  @media (max-width: 40rem) {
    /* On the rail as well as the room. The rail is a sibling and every one of
       its numbers is built from --gr-art: its rest position is a negative
       margin of exactly the piece's height, so a stale value there does not
       merely draw the piece at the wrong size — it pulls the whole page up
       under the room and swallows the first paragraph. */
    /* the hall's own figure, so the piece is the same object at the same
       size in both rooms — see 'one piece, one size' in plinth.css */
    .gr, .gr__rail { --gr-art: var(--piece-h); }
    .gr { block-size: clamp(17rem, 50svh, 24rem); }
    /* the keys stack down the right here, so the mark rides just under the
       museum's name rather than beside it */
    /* and when it is caught it becomes the size the hall's own pieces are
       when they withdraw */
    .gr__rail[data-pinned] .gr__piece { scale: var(--piece-back-k); translate: 0.4rem 2.6rem; }
    .gr__in { gap: 0.5rem; }
    .gr__title { font-size: var(--step-2); }
    .gr__cue .bh__cue-txt { display: none; }
  }

  /* ---------- header ---------- */
  .gh {
    border-block-end: 1px solid var(--line);
    background:
      radial-gradient(60% 120% at 8% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 68%),
      var(--bg-1);
    padding-block: clamp(1.8rem, 5vw, 3rem);
  }
  .gh__in { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
  .gh__art { --sculpt-hi: #ffe9c2; --sculpt-lo: #a06a2a; flex: none; }
  @media (max-width: 40rem) { .gh__art { display: none; } }
  .gh__back { text-decoration: none; color: var(--muted); }
  .gh__back:hover { color: var(--gold); }
  .gh__title { font-size: var(--step-3); color: var(--cream); margin-block-start: 0.3rem; }
  .gh__title .conj { font-size: 0.55em; opacity: 0.68; margin-inline: 0.2em; vertical-align: 0.1em; }
  .gh__title-en {
    font-family: var(--font-body);
    font-size: var(--step-0);
    letter-spacing: .08em;
    color: var(--muted);
    margin-block-start: .1rem;
  }

  .gh__n { font-size: var(--step--1); color: var(--accent); letter-spacing: 0.14em; margin-block-start: 0.3rem; }

  /* ---------- what this prize is ---------- */
  .about { border-block-end: 1px solid var(--line); background: var(--bg-0); overflow: visible; }
  .about__in {
    display: grid; gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(1.8rem, 5vw, 2.8rem) clamp(1.2rem, 3vw, 1.8rem);
  }
  @media (min-width: 58rem) { .about__in { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: start; } }
  .about__lede { font-size: var(--step-1); line-height: 1.9; color: var(--text); max-inline-size: 56ch; }
  .about__hist {
    margin-block-start: 1rem; font-size: var(--step-0); line-height: 1.85;
    color: var(--muted); max-inline-size: 56ch;
    padding-inline-start: 1rem; border-inline-start: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .about__figures { display: grid; gap: 0.6rem; align-content: start; }
  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 0.9rem; margin: 0;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); padding: 1.1rem 1.2rem;
  }
  .stats__item { text-align: start; }
  .stats dt { font-size: 0.66rem; letter-spacing: 0.1em; color: var(--muted-dim); line-height: 1.4; }
  .stats dd {
    margin: 0.15rem 0 0; font-family: var(--font-display);
    font-size: var(--step-2); color: var(--accent); line-height: 1.1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* ---------- materials strip: titles only, detail on hover/focus ---------- */
  .mats {
    display: flex; flex-wrap: wrap;
    padding-block: clamp(1.2rem, 3vw, 1.7rem) clamp(1.5rem, 4vw, 2.4rem);
    border-block-start: 1px solid var(--line);
  }
  /* the popup anchors to this list, so it always spans the strip and can
     never overflow the viewport, whichever button is pointed at */
  .mats__list {
    position: relative; inline-size: 100%;
    display: flex; flex-wrap: wrap; gap: 0.65rem; padding: 0; margin: 0;
  }

  /* The bright museum makes these museum-glass-btn--nav; what stays here is the
     dark site's own treatment, and the layout the button does not set. */
  .mat__link {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: var(--step-0); font-weight: 500; line-height: 1.3;
    color: var(--on-accent); text-decoration: none;
    background: linear-gradient(158deg,
      color-mix(in srgb, var(--accent-block) 95%, #fffaf0),
      color-mix(in srgb, var(--accent-block) 84%, #8a6535));
    border: 1px solid color-mix(in srgb, var(--accent-block) 88%, #fffaf0);
    border-radius: var(--radius-control);
    padding: 0.62rem 1.4rem;
    box-shadow: 0 2px 14px -5px color-mix(in srgb, var(--accent-block) 50%, transparent);
    transition: filter 0.25s var(--ease), transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .mat__link:hover, .mat__link:focus-visible {
    filter: brightness(1.1) saturate(1.05);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -8px color-mix(in srgb, var(--accent-block) 78%, transparent);
  }
  .mat__link:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 3px; }
  .mat__ext { font-size: 0.9em; opacity: 0.65; }

  .mat__tip {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(100% + 0.6rem);
    z-index: 20;
    display: grid; gap: 0.3rem;
    padding: 0.85rem 1.05rem;
    background: var(--bg-2);
    border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--line));
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
    opacity: 0; visibility: hidden; translate: 0 -0.35rem;
    transition: opacity 0.22s var(--ease), translate 0.22s var(--ease), visibility 0.22s;
    pointer-events: none;
  }
  .mat__tip-d { font-size: var(--step--1); color: var(--text); line-height: 1.65; }
  .mat__tip-h { font-size: 0.66rem; letter-spacing: 0.08em; color: var(--accent); }

  .mat:hover .mat__tip,
  .mat__link:focus-visible + .mat__tip {
    opacity: 1; visibility: visible; translate: 0 0;
  }

  /* no hover on touch — show the detail inline instead of hiding it entirely */
  @media (hover: none) {
    .mat__tip {
      position: static; opacity: 1; visibility: visible; translate: 0;
      box-shadow: none; background: transparent; border: 0;
      padding: 0.15rem 0 0.5rem 0.2rem;
    }
    .mats__list { flex-direction: column; align-items: stretch; gap: 0.9rem; }
    .mat { display: grid; justify-items: start; gap: 0.3rem; }
  }

  .asof { margin: 0; font-size: 0.66rem; color: var(--muted-dim); line-height: 1.6; }

  /* ---------- body ---------- */
  .gh__body { display: grid; gap: clamp(2.5rem, 7vw, 4.5rem); padding-block: clamp(2rem, 5vw, 3rem); }
  .sec-h { font-size: var(--step-2); color: var(--cream); }
  .sec-h::after {
    content: ''; display: block; inline-size: 3rem;
    border-block-start: 1px solid var(--accent); margin-block-start: 0.6rem; opacity: 0.7;
  }

  .grid {
    display: grid; gap: clamp(0.9rem, 2vw, 1.5rem); padding: 0; margin-block-start: 1.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .empty {
    display: grid; gap: 0.8rem; max-inline-size: 48rem; margin-block-start: 1.6rem;
    border: 1px dashed var(--line-hi); border-radius: var(--radius);
    padding: clamp(1.4rem, 4vw, 2.4rem); background: var(--surface);
  }
  .empty__t { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); }
  .empty__b { color: var(--muted); line-height: 1.85; }

  /* ---------- materials ---------- */
  .materials__note { font-size: var(--step--1); color: var(--muted); margin-block-start: 0.9rem; }
  .cards {
    display: grid; gap: 0.9rem; padding: 0; margin-block-start: 1.4rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .cards a {
    display: grid; gap: 0.3rem; block-size: 100%; text-decoration: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.1rem 1.25rem 0.95rem;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .cards a:hover, .cards a:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: var(--surface-hi); transform: translateY(-2px);
  }
  .cards__t { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); line-height: 1.35; }
  .cards__d { font-size: var(--step--1); color: var(--muted); line-height: 1.65; }
  .cards__host {
    margin-block-start: 0.45rem; font-size: 0.66rem; letter-spacing: 0.08em;
    color: var(--muted-dim); font-family: var(--font-body);
  }
  .cards a:hover .cards__host { color: var(--accent); }

</style>

<script>
  import '../../vendor/model-viewer.min.js';
  import { dressPlinths } from '../scripts/plinth';
  /* one piece rather than six, but the same object — same drum, same rings,
     same name bent onto the same cylinder */
  dressPlinths();

  /* The rail does the pinning; this only says when the piece has been caught,
     so it can become a mark. A boolean toggled on a rAF, not a position
     recomputed on one — the sticky element itself never waits for script. */
  const rail = document.querySelector<HTMLElement>('.gr__rail');
  if (rail) {
    const stick = () => parseFloat(getComputedStyle(rail).insetBlockStart) || 0;
    let ticking = false;
    const test = () => {
      rail.toggleAttribute('data-pinned', rail.getBoundingClientRect().top <= stick() + 1);
      ticking = false;
    };
    test();
    addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(test);
    }, { passive: true });
    addEventListener('resize', test);
  }
</script>
