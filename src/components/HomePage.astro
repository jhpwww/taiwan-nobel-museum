---
import Base from '../layouts/Base.astro';
import Hall from './Hall.astro';
import LectureCard from './LectureCard.astro';
import VideoFacade from './VideoFacade.astro';
import { useT, type Lang } from '../i18n/ui';
import { browse, lecture as lectureUrl } from '../i18n/routing';
import { lectures, byDateDesc, catName, totalVideos } from '../data/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const byDate = byDateDesc();
const withGuide = lectures.filter((l) => l.video.guide);
const featured = withGuide[0] ?? lectures[0];
const latest = byDate.filter((l) => l.id !== featured.id).slice(0, 6);
const featuredCat = catName(featured.prize.category, lang);

const nVideos = totalVideos();
---

<Base lang={lang} bare>
  <Hall lang={lang} />

  <section class="strip">
    <div class="wrap">
      <dl class="stats">
        <div><dt>{lectures.length}</dt><dd>{t('hall.stat.lectures')}</dd></div>
        <div><dt>{lectures.length}</dt><dd>{t('hall.stat.laureates')}</dd></div>
        <div><dt>{nVideos}</dt><dd>{t('hall.stat.videos')}</dd></div>
      </dl>
    </div>
  </section>

  <section class="feature wrap" aria-labelledby="feat-h">
    <h2 id="feat-h" class="section-h">{t('hall.featured')}</h2>
    <div class="feature__grid" data-cat={featured.prize.category}>
      <VideoFacade
        id={(featured.video.guide ?? featured.video.lecture)!}
        title={`${featured.laureate[lang]} — ${featured.title.en}`}
        kind="guide"
        label={featured.video.guide ? t('lec.guide') : t('lec.lecture')}
        playHint={t('lec.playHint')}
        eager
      />
      <div class="feature__text stack">
        <p class="eyebrow">{t('lec.prize', { year: featured.prize.year, category: featuredCat })}</p>
        <h3>{featured.laureate[lang]}</h3>
        {lang === 'zh' && <p class="gloss">{featured.laureate.en}</p>}
        <p class="feature__hook">{featured.hook[lang]}</p>
        <p>{featured.description[lang]}</p>
        <p><a class="more" href={lectureUrl(lang, featured.id)}>{t('hall.watch')} →</a></p>
      </div>
    </div>
  </section>

  <section class="latest wrap" aria-labelledby="latest-h">
    <div class="section-head">
      <h2 id="latest-h" class="section-h">{t('hall.latest')}</h2>
      <a class="more" href={browse(lang)}>{t('nav.all')} →</a>
    </div>
    <ul class="grid" role="list">
      {latest.map((rec) => <li><LectureCard lang={lang} rec={rec} /></li>)}
    </ul>
  </section>
</Base>

<style>
  .strip { border-block: 1px solid var(--line); background: var(--bg-1); }
  .stats {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: clamp(1.5rem, 6vw, 5rem); padding-block: 1.6rem; margin: 0;
  }
  .stats div { text-align: center; }
  .stats dt {
    font-family: var(--font-display); font-size: var(--step-3);
    color: var(--gold-bright); line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .stats dd { margin: 0.3rem 0 0; font-size: var(--step--1); color: var(--muted); letter-spacing: 0.1em; }

  .section-h { font-size: var(--step-2); color: var(--cream); }
  .section-h::after {
    content: ''; display: block; inline-size: 3rem;
    border-block-start: 1px solid var(--gold); margin-block-start: 0.6rem; opacity: 0.6;
  }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

  .feature { margin-block-start: clamp(3rem, 8vw, 5.5rem); }
  .feature__grid { display: grid; gap: clamp(1.25rem, 3vw, 2.5rem); margin-block-start: 1.8rem; }
  @media (min-width: 56rem) { .feature__grid { grid-template-columns: 1.25fr 1fr; align-items: center; } }
  .feature__text { --gap: 0.5rem; }
  .feature__hook {
    font-family: var(--font-han-serif); font-size: var(--step-1);
    color: var(--accent); line-height: 1.5;
  }
  .more { font-size: var(--step--1); letter-spacing: 0.1em; text-decoration: none; color: var(--gold); }
  .more:hover { color: var(--gold-bright); }

  .latest { margin-block-start: clamp(3rem, 8vw, 5.5rem); }
  .grid {
    display: grid; gap: clamp(0.9rem, 2vw, 1.5rem); margin-block-start: 1.8rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
</style>
