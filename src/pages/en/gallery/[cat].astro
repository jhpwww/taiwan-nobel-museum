---
import GalleryPage from '../../../components/GalleryPage.astro';
import { galleryKeys } from '../../../data/catalog';

export function getStaticPaths() {
  return galleryKeys().map((cat) => ({ params: { cat }, props: { cat } }));
}
const { cat } = Astro.props;
---
<GalleryPage lang="en" cat={cat} />
